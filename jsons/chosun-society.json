[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"면도하는 무, 출근하는 버섯… 관람객 빵 터진 ‘아시아프’","partialText":"아시아 최대 청년 작가 미술 축제 ‘2025 아시아프(ASYAAF·Asian Students and Young Artists Art Festival, ~9월 7일, 이하 아시아프)’를 시작으로 ‘대한민국미술축제 2025’(이하 대한민국미술축제)도 막이 올랐다. 이후 10여 개의 비엔날레와 아트페어가 릴레이 경주하듯 이어진다. 올해 18회째를 맞이하는 아시아프는 첫 회 개최 장소였던 구 서울역이자 복합 문화 공간인 ‘문화역서울284’에서 열린다. 광복 80주년·서울역 개장 100주년이기도 한 해, 아시아프를 계기로 대한민국미술축제의 주 무대 중 하나가 된 근·현대 건축 공간으로 아트 투어에 나섰다.","date":"2025-08-22T15:33:00.000Z","url":"https://www.chosun.com/national/weekend/2025/08/23/HQ72O7PDU5E6DDXY5AJZGWDZ2Y/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"서울고검, 김건희 ‘허위 경력’ 의혹 재수사 여부 검토한다","partialText":"","date":"2025-08-23T10:45:03.000Z","url":"https://www.chosun.com/national/court_law/2025/08/23/AE5SXGOTOJE7LP3CKYIFNWRLGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"장애인 동료 음식에 침 뱉은 국회 공무원... 항소심도 “해임 정당”","partialText":"","date":"2025-08-23T11:33:57.000Z","url":"https://www.chosun.com/national/court_law/2025/08/23/XBPRCVTRVNBRZL5UKOCSDAGQN4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"고흐는 죽은 스승에게  받은 씨앗을 화폭에 뿌렸다","partialText":"","date":"2025-08-22T15:33:00.000Z","url":"https://www.chosun.com/national/weekend/2025/08/23/QIQJRVBTE5B5ZKNI2IVAF2MTQE/"},{"spec":{"publisher":{"id":"chosun","
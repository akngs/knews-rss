[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"빛 수집한 화가들의 시선 따라... 한나절 만에 즐기는 세계여행","partialText":"겨울방학이 시작됐다. 북적거리는 인파에 섞여 연말연시 기분 내기엔 도심을 포기할 수 없다. 추위 피하며 세계 여행하듯 해외 명화, 인기 작품, 명소를 만날 수 있는 서울 도심 전시장 여행은 어떨까. 인상주의부터 초기 모더니즘 작품을 한 번에 만날 수 있는 귀한 미술전, 세계 주요 도시 풍경을 카메라에 담아낸 사진전, VR(가상현실) 체험으로 이집트 피라미드를 신나게 탐험하는 이색 체험전이 서울 곳곳에서 동시 진행 중이다. 교통카드 한장 들고 19세기 프랑스 그림에서 시작해 지중해 해변을 거쳐 피라미드까지, 시공간을 초월하는 세계 여행을 떠났다. 전시장 앞으로!","date":"2025-12-19T15:40:00.000Z","url":"https://www.chosun.com/national/weekend/2025/12/20/KKCOFP4U4FAIJA6AHHTXBBXVRE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"‘9세 6개월’… 바둑 최연소 입단 기록 63년 만에 깨졌다","partialText":"","date":"2025-12-19T15:52:00.000Z","url":"https://www.chosun.com/national/people/2025/12/20/WPNSIDQO75ERVIFTR6YPHDJBYQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"만 65세 이상 어르신, 내년부터 한의사가 가정 방문해 진료","partialText":"","date":"2025-12-19T15:54:00.000Z","url":"https://www.chosun.com/national/welfare-medical/2025/12/20/Q3N5FDVZ6ZHKRLA2NYNYJC4ZUE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"사회","categories":["society"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/national/?outputType=xml"},"title":"[단독] 임은정 동부지검장 “백해룡, 경찰로 되돌려 보내달라”","partialText":"","date":"2025-12-19T20:02:00.000Z","url":"https://www.chosun.com/national/national_general/2025/12/20/GVZH5BHAVNCKFI6RFRP46IJRXA/"},{"spec":{"publisher":{"id":"chosun","nam
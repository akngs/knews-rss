un.com/economy/tech_it/2025/12/21/PRXJXOZBNJBPZPBXZL6XEBEUBE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"HD현대중공업, 페루 해군 차세대 잠수함 공동개발…다음달 설계 착수","partialText":"","date":"2025-12-21T03:32:27.000Z","url":"https://www.chosun.com/economy/industry-company/2025/12/21/L3HGAZ3S4JEAZESFGQQECWHHXQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"새해 농협혁신위원회 출범…“중앙회장 선출방식 등 외부 시각으로 농협 문제 원천 차단”","partialText":"","date":"2025-12-21T02:30:25.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/XO2VSBAB25HARG4AWRMF4L3DGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"소비자분쟁조정위, SKT 해킹 피해자에 10만원 상당 보상 결정","partialText":"","date":"2025-12-21T03:11:20.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/66LOKIOOR5FKNJNEG736YSQ5VA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"금감원, 대통령 ‘이너서클’ 비판에 BNK금융 검사 예정","partialText":"금융감독원이 BNK금융지주를 대상으로 차기 회장 선임 절차에 문제가 없는지 등을 살펴보기 위해 내년 1월 중 검사에 착수할 방침으로 전해졌다. 이재명 대통령이 지난 19일 업무 보고에서 금융 기관 지배 구조와 관련해 ‘부패한 이너서클’이 지속적으로 지배권을 행사한다고 지적한 데 따른 조치로 풀이된다. 앞서 BNK금융지주는 지난 8일 임원후보추천위원회와 이사","date":"2025-12-21T11:44:36.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/12/21/MZQTOMRWHBQWCOLGME4DQMBRMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"고물가에 자녀 학원비까지 줄인다···사교육비 지출 5년 만에 첫 감소","partialText":"","date":"2025-12-21T01:28:33.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/LRWR6NAU3VAXTHOZCXXESRKZGU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"당정대 “부동산 공급대책 협의 마무리 단계… 발표는 내년 1월로 넘어갈 수도”","partialText":"정부가 ‘10·15 부동산 대책’ 후속 과제로 추진하고 있는 주택 공급 방안에 대한 협의가 마무리 단계에 접어들었다. 구체적인 방안은 내년 1월 중 발표될 전망이다. 박수현 더불어민주당 수석대변인은 21일 서울 국무총리 공관에서 열린 제5차 고위당정협의회 결과 브리핑에서 주택 공급 대책 발표 시기를 묻는 질문에 “(김윤덕) 국토교통부 장관이 (국회) 상임위","date":"2025-12-21T10:32:31.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/GYZWINTDGVRDGY3FMNSWMN3GGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘용인 푸르지오 클루센트’ 견본주택에 3일간 1만2000명 몰려","partialText":"","date":"2025-12-21T05:46:47.000Z","url":"https://www.chosun.com/economy/real_estate/2025/12/21/5TSGXVZ7ANFYJLCVAVM365Q37U/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"전남 나주 오리농장서 고병원성 조류인플루엔자 발생","partialText":"고병원성 조류인플루엔자(AI) 중앙사고수습본부가 21일 전남 나주시의 한 육용 오리 농장에서 AI가 발생했다고 밝혔다. 해당 농장에서는 오리 약 2만3000마리를 사육 중이었으며, 도축 출하 전 실시한 정기 예찰 검사에서 고병원성 AI가 검출됐다. 이번 동절기 국내 가금농장에서 발생한 16번째 사례다.  중수본은 항원을 확인한 직후 방역 조치를 시행했다.","date":"2025-12-21T09:03:45.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/MEZTINRYHA4WKMRWGRSTENTCHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"조국 “나도 탈팡”... 정치·문화계 쿠팡 탈퇴 인증 행렬","partialText":"","date":"2025-12-21T08:22:10.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/4PEGBYVD4JHSPMYVK4MAOWLJUY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"김민석 총리 “석화·철강 구조개편 불가피…근로자 보호 주력할 것”","partialText":"김민석 국무총리는 21일 고위 당정 협의 모두 발언에서 “석유화학 및 철강 구조개편이 불가피한 상황”이라고 했다. 그러면서 “정부는 기업의 혁신을 지원하는 동시에 근로자 보호 및 지역경제의 충격 완화에도 주력하겠다”고 했다.  이날 오후 4시 대통령실과 정부, 더불어민주당은 고위 당정 협의를 개최했다. 대통령실과 당정은 석유화학 및 철강 구조조정 후속 대책","date":"2025-12-21T08:08:22.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/GRRTOZDCMEYGKNJUMI2DOMLDMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"삼성전자, 페루에 냉난방공조 교육센터 설립…중남미 공략 강화","partialText":"삼성전자가 중남미 냉난방공조(HVAC) 공략에 나섰다. 21일 업계에 따르면 삼성전자는 최근 페루 북부 치클라요에 HVAC 전문 엔지니어와 설치 기사 양성을 위한 ‘삼성 HVAC 전문 교육센터’를 개소했다. 이번 센터 개소는 제품 공급을 넘어 설치·유지보수 역량까지 아우르기 위한 작업의 일환으로, 기업간거래(B2B) 공조 시장에서 경쟁력을 끌어올리려는 전","date":"2025-12-21T07:49:01.000Z","url":"https://www.chosun.com/economy/tech_it/2025/12/21/MY2GMMRUGY3GGMRYMQ2DOYZZG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[송혜진의 한입 과학] 당뇨 있으세요? 창가에 앉으세요","partialText":"","date":"2025-12-19T23:00:00.000Z","url":"https://www.chosun.com/economy/science/2025/12/20/7PMO3LJ75JGINHY3XCJEBMJYEE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"한은 “AI 확산으로 구조적 실업 확대될 것”","partialText":"인공지능(AI) 확산이 구조적 실업을 늘리는 등 고용시장에 부정적 영향을 줄 수 있다고 한국은행이 분석했다. 21일 한은에 따르면 김좌겸 한은 뉴욕사무소 차장은 최근 공개한 ’2026년 미국경제 전망 및 주요 이슈' 보고서에서 AI 확산이 미국 고용시장에 미칠 영향에 대해 이같이 밝혔다.  김 차장은 보고서에서 “올해 하반기 미국의 고용시장이 부진한 데에는","date":"2025-12-21T07:45:40.000Z","url":"https://www.chosun.com/economy/economy_general/2025/12/21/MNRWCNZYGIYDANJWGVQTKZJZGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"고려아연 vs 영풍·MBK, 美제련소 유증 가처분 판단 임박하자 ‘치열한 공방’","partialText":"고려아연이 미국 테네시주 클락스빌(Clarksville) 제련소 투자를 위해 추진하는 제3자 배정 유상증자에 대해 영풍·MBK파트너스(영풍 측)가 신청한 가처분의 법원 판단이 임박하면서 영풍 측과 고려아연의 공방이 치열해지고 있다. 영풍 측은 21일 공식자료를 내고 “고려아연의 미국 제련소 건설과 관련해 최종 합작 계약이 체결되지 않아도 합작법인(JV)이","date":"2025-12-21T07:43:59.000Z","url":"https://www.chosun.com/economy/industry-company/2025/12/21/MUZDQMRZHA3WCY3DG5RDQMLDGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"뿌리고 30분 후 물로 씻어냈더니, 새 집 같은 욕실과 주방","partialText":"","date":"2025-12-20T20:05:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/12/21/FZIN2U3KAJH4NLCM75GTOTJSTU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘전동칫솔에 치실 꽂았더니’ 20억원 대박 낸 아이디어","partialText":"","date":"2025-12-19T20:30:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/12/20/AUSMCXMC6RBULGUJIKUUC727UY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"고려아연 “MBK·영풍, 이사회 장악에 혈안… 美정부, 제련소 사업비 91% 책임져”","partialText":"고려아연은 영풍·MBK파트너스(영풍 측)가 미국 제련소 건설과 관련해 최종 합작계약이 체결되지 않아도 합작법인(JV)의 고려아연 지분 10%를 미 정부가 보유하게 된다는 주장을 반박했다. 영풍 측이 고려아연 이사회 장악을 위해 비상식적인 가정으로 미국 제련소 건설을 무산시키려 한다고 주장했다. 21일 고려아연에 따르면 영풍 측이 이날 언급한 ‘사업제휴 프레","date":"2025-12-21T07:33:11.000Z","url":"https://www.chosun.com/economy/industry-company/2025/12/21/GVTGKMLGMM3TKZDDMU4WCZRUHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"대기업 사표 후 인생 걸었다, 서울대 공대 나와 개발한 눈 마사지기","partialText":"","date":"2025-12-19T20:15:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/12/20/7SVPKHY5M5E3TISYGWJOV4YZCA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"제미나이로 반등한 구글, 올해 영입한 AI 인재 20%는 ‘전 직원’","partialText":"오픈AI, 메타, 앤트로픽 등 인공지능(AI) 기업의 인재 영입 경쟁이 치열해지는 가운데 구글이 전 직원을 공격적으로 채용해 경쟁력을 유지하고 있다는 분석이 나왔다. CNBC는 구글이 올해 채용한 AI 분야 소프트웨어 엔지니어의 약 20%가 다른 회사로 이직했다가 구글로 돌아온 이른바 ‘부메랑 직원’이었다고 20일(현지시각) 보도했다. 구글은 CNBC에","date":"2025-12-21T07:20:10.000Z","url":"https://www.chosun.com/economy/tech_it/2025/12/21/GE4TSYZUGNRGCZJUMIYGIMTDGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"여한구 통상본부장, 캐나다 통상장관 만나 ‘철강 관세’ 우려","partialText":"","date":"2025-12-21T06:56:03.000Z","url":"https://www.chosun.com/economy/industry-company/2025/12/21/UH3KRCQOMZESRKAC2RIEKR2NRM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘오픈AI에  올인’ 하는 손정의, Arm 지분까지...","partialText":"","date":"2025-12-21T06:22:26.000Z","url":"https://www.chosun.com/economy/tech_it/2025/12/21/J57U4344ZZCNJATC2DSWOQ22XM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"금융연구원 “올해 9월이 경기 저점… 역대 최장 수축기 가능”","partialText":"김현태 한국금융연구원 연구위원은 21일 ‘최근 경기전환점 발생 여부 추정’ 보고서에서 한국 경제가 2022년 11월부터 수축해 올해 9월 저점을 찍고 다시 확장기에 접어들 수 있다는 연구 결과를 밝혔다. 김 위원이 머신러닝 알고리즘 일종인 학습벡터양자화를 이용해 경기동행지수 변수와 심리지수 등을 분석한 결과, 한국 경제는 2022년 11월 정점을 찍고 경기","date":"2025-12-21T06:13:56.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/12/21/GRRDOYJVGZTGEOLGGAYTSNZVMU/"}]
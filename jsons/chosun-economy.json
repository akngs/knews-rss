com/economy/tech_it/2025/11/25/VDCJMEITUJA43LCLS4WG7MDLTY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"고환율에도 3분기 해외 카드 사용액 사상 최대","partialText":"","date":"2025-11-25T03:00:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/BTRGPPGAS5GAZGEAQQHPN3PK3A/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"롯데케미칼, 대산 NCC 가동 중단할듯... 이르면 이번주 결론","partialText":"","date":"2025-11-25T09:31:47.000Z","url":"https://www.chosun.com/economy/industry-company/2025/11/25/KDZFUIKZZ5HO7OBSQ5OWUKA6UM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"잇단 부동산 대책에도…‘1년 후 집값 더 오른다’ 전망 여전히 우세","partialText":"","date":"2025-11-24T21:00:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/KHX6YTF3GFEDDBVMUZCZQMS6RQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"박찬욱도 ‘RM 뮤비’ 만든 에미상 감독도 이 남자에게 ‘SOS’","partialText":"","date":"2025-11-25T02:17:52.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/BA4MVOPX4ZDABAHGOQMNECQXRM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"수도권 주택난에 단비 되나... 2030년까지 ‘뉴스테이’ 4만가구 풀린다","partialText":"","date":"2025-11-24T22:00:00.000Z","url":"https://www.chosun.com/economy/real_estate/2025/11/24/UDJ7YIC5IVFM7NHRD5P3JDCSBY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"신한투자증권 “美 주식 주간거래 재개 후 거래액 24% 증가”","partialText":"신한투자증권은 미국 주식 주간거래가 이달 초 재개된 이후 거래 규모가 빠르게 회복했다고 25일 밝혔다. 지난 11월 4일부터 17일까지 2주간 미국 주식의 일평균 거래금액은 전월 대비 24% 증가한 것으로 나타났다. 미국 주식 주간거래는 국내 투자자가 한국 시각 기준 오전 9시부터 오후 5시까지 미국 주식을 실시간으로 거래할 수 있도록 지원하는 제도다.","date":"2025-11-25T09:53:35.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/MRSGKYRQGNRTCMBQG4YDKM3BG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"“해커의 양자컴퓨터 공격 대비해야”…이스라엘 사이버보안 기업, 韓과 협력 강화","partialText":"“한국의 제조 경쟁력에 이스라엘의 혁신 보안 역량을 결합하면 미래 산업을 선점할 수 있다.” 라파엘 하르파즈 주한 이스라엘 대사는 25일 서울 삼성동 트레이드타워에서 열린 ‘2025 한-이스라엘 오픈이노베이션 써밋’에서 이같이 말했다. 주한이스라엘대사관 경제무역대표부와 한국무역협회가 공동 개최한 이번 행사에는 이스라엘 사이버보안·벤처캐피탈(VC) 기업 사","date":"2025-11-25T09:48:52.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/MQ2DMZJWGM4GGZRRGIYTGNZVGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"메타 “구글 AI 칩 도입 검토”…엔비디아 대안 될까","partialText":"페이스북·인스타그램 모회사인 메타가 구글 인공지능(AI) 칩을 도입하는 방안을 논의 중이라고 블룸버그통신이 25일 보도했다. 블룸버그에 따르면 그동안 엔비디아 그래픽처리장치(GPU)를 사용해 온 메타는 2027년 구글이 자체 개발한 텐서처리장치(TPU)를 수십억달러 규모로 도입해 데이터센터를 구축하는 방안을 검토 중이다. 또 메타가 내년에 구글 클라우드에","date":"2025-11-25T09:48:03.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/MM4DEOBQGI2TKMRWHAYGIZJTGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"공정위 보란듯 “SK하이닉스는 국가 성장 엔진” 강조한 SK","partialText":"","date":"2025-11-25T02:41:30.000Z","url":"https://www.chosun.com/economy/industry-company/2025/11/25/R2NRBEDJZNBK5GG4JMYU67XXZI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"이재용, 아시아 ‘최대 부호’ 암바니와 회동… 신기술 사업 확대 논의","partialText":"이재용 삼성전자 회장이 ‘아시아 최대 부호’로 불리는 무케시 암바니 릴라이언스 인더스트리 회장을 25일 만나 반도체·통신·데이터센터·배터리 등 신사업 분야에 대한 협력 확대 방안을 논의했다. 암바니 회장은 순자산이 1160억달러(약 170조원)에 이르는 인도 최대 갑부다. 릴라이언스그룹은 석유화학·철강·통신·소매업·금융 등에서 사업을 영위하는 인도 최대","date":"2025-11-25T09:30:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/GQ3DSMJSMVSTKODBGY2GEMTBGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"해수부, 세종서 부산으로 이사...다음달 8일부터","partialText":"","date":"2025-11-25T09:12:13.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/EIUVL6VHQFHWPOIOOFUOQH3FL4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"메리츠證, 5000억원 규모 유상증자… ‘8조원 종투사’ 도약 채비","partialText":"메리츠증권이 5000억원 규모의 유상증자를 단행하며 종합금융투자사업자(종투사)로의 도약을 위한 기반을 마련했다. 이번 증자로 자기자본이 7조원 후반대로 늘어나면서, 8조원 이상 자기자본 요건을 갖춘 종투사 지정에 한 걸음 더 다가섰다는 평가가 나온다. 메리츠증권은 25일 제3자배정 유상증자를 결정했다고 공시했다. 전환우선주(CPS) 형태로 3875만679","date":"2025-11-25T09:17:30.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/GZSTAMDGGY4TEYRWMEYWKMZVGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"대한항공, 20년 쓴 기내식 용기 소재 식물성 원료로 바꾼다","partialText":"대한항공이 20여년간 사용한 기내식 용기의 소재를 식물성 원료로 전환한다고 25일 밝혔다.  신규 기내식 용기 소재는 비목재 펄프로 일반석 고객의 기내식의 주 요리를 담는 용기에 적용된다. 대한항공은 신소재 적용 용기를 올해 12월부터 일부 노선에 도입해 2026년 말까지 확대 적용할 방침이다. 신소재는 나무를 벌목하지 않고도 생산 가능하다는 점에서 친환경","date":"2025-11-25T09:11:05.000Z","url":"https://www.chosun.com/economy/industry-company/2025/11/25/GIYGKOBXGYZWCZTDMFRWMYTCGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘206% 폭증’ BYD 공세에… 현대차그룹, 10월 유럽 점유율 하락","partialText":"현대차·기아의 지난 10월 유럽 시장 점유율이 1년 전 같은 기간보다 0.5%포인트 떨어진 것으로 나타났다. 유럽 시장 전체 판매량이 전년 동기 대비 5% 가까이 늘어난 가운데 받아든 아쉬운 성적표다. BYD 판매량이 200% 넘게 폭증하는 등 중국차 공세 영향을 받은 것으로 풀이된다. 25일 유럽자동차공업협회(ACEA)와 외신 등에 따르면, 지난달 유럽에","date":"2025-11-25T08:59:51.000Z","url":"https://www.chosun.com/economy/industry-company/2025/11/25/HFQTONZYGJSWCMLEGQ3TCNZWGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"해군 입대한 이재용 장남, 임관식서 기수 대표로 지휘","partialText":"미국 시민권을 포기하고 해군 장교로 입대한 이재용 삼성전자 회장의 장남 이지호(24)씨가 임관식에서 기수 대표로 제병 지휘를 한다.  25일 해군에 따르면 이씨는 오는 28일 경남 창원 해군사관학교에서 열리는 해군 학사사관후보생 139기 임관식에서 후보생 전체를 통솔한다. 후보생은 이씨를 포함해 모두 84명이다. 2000년 미국에서 태어나 한국과 미국 복수","date":"2025-11-25T08:44:01.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/GRQTSOLCMJRDGOLGGUZGMOJVGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"SK브로드밴드, 인터넷 보안 서비스 통합한 ‘안심 기가 윙즈’ 출시","partialText":"SK브로드밴드가 인터넷 보안 서비스를 통합한 안심 서비스를 출시했다. SK브로드밴드는 기존의 보안 부가서비스를 하나로 묶어, 고객이 한 번 가입으로 유해사이트·악성코드 차단, 바이러스 감시·치료, PC·스마트폰 원격 및 방문 점검 등 3중 보안 기능을 이용할 수 있는 ‘안심 기가 윙즈’를 선보인다고 25일 밝혔다. 상품에 따라 메리츠화재와 제휴해 보이스피","date":"2025-11-25T08:41:36.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/MU4WIMBVGBRDAMTFHFQTIMRYGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"해수부, 12월 8~19일 부산으로 이사간다","partialText":"해양수산부가 다음달 8~19일 부산으로 이전한다고 25일 밝혔다. 해수부 부산 이전은 이재명 대통령 공약이었다. 해수부는 부산 1호선 부산진역 인근 임사 청사를 쓰다가 향후 건립할 정식 청사로 이전할 예정이다. 해수부는 이날 기자단에 보낸 보도참고자료에서 “8일부터 12일간 실국별로 매일 순차적으로 이사를 갈 것”이라고 했다. 이사에는 5톤 트럭 249대","date":"2025-11-25T08:35:26.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/HA2TGNRYMJQWEMBZMEZTSZBVMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"거제도 해녀가 잡은 돌문어, 2~4마리 2만원대 특가 산지 직송","partialText":"","date":"2025-11-25T08:34:36.000Z","url":"https://www.chosun.com/economy/startup_story/2025/11/25/5DR2ENV32RCRTM4GDKH5WJ4ESI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"젠슨황 옆 미인이 중국 스파이? 미·중 ‘AI부품 밀수전쟁’","partialText":"","date":"2025-11-24T18:00:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/7OAHGP7NS5A3XGFXUXCYRMFIM4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"서울 3대 설렁탕 이남장, 2인분 같은 1인분에 7400원","partialText":"","date":"2025-11-25T08:29:15.000Z","url":"https://www.chosun.com/economy/startup_story/2025/11/25/Q3IRNZMF4NEP7DSFNKTZHGL2ZU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"매일 8시간 써도 전기요금 월 1만원대, 난방비 확 줄이는 카본 히터 5만원대 특가","partialText":"","date":"2025-11-25T08:28:27.000Z","url":"https://www.chosun.com/economy/startup_story/2025/11/25/5EUBTJ57GZETNHJHNWA576H6IM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"베트남동, 태국바트보다 더 떨어진 원화 가치… “동남아 여행도 부담스럽다”","partialText":"","date":"2025-11-25T00:11:56.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/7IOWADFD5JA2FLG7AHYQEXUTXA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘역전세 반환대출’ 규제 완화 일몰 규정 폐지… 상시 제도로 전환","partialText":"금융 당국이 올해 종료 예정이던 역전세 반환대출 규제 완화 조치를 상시 운영하기로 했다. 25일 금융위원회는 역전세 반환대출 규제 완화 조치의 일몰 규정을 삭제하는 내용의 ‘은행업 감독규정 일부 개정안’을 입법 예고했다.  역전세 반환대출 규제 완화 조치는 갑작스러운 전세가격 하락으로 전세금 반환이 지연되거나, 전세금을 돌려받지 못할까 불안해하는 세입자들을","date":"2025-11-25T08:23:59.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/MM2WCMJVGVSGIMRSHEZWCMLBMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"발사 임박한 누리호, 발사대에 기립… 최종 점검 단계 진입","partialText":"발사를 이틀 앞둔 한국형발사체 누리호(KSLV-Ⅱ)가 25일 나로우주센터 발사대에 성공적으로 기립하며 본격적인 최종 점검 절차에 돌입했다. 우주항공청과 한국항공우주연구원은 이날 오후 1시 36분 전남 고흥군 나로우주센터 제2발사대에서 누리호의 기립과 고정 작업을 마무리했다고 밝혔다. 누리호는 오전 9시쯤 무인 특수이동차량 ‘트랜스포터’에 실려 종합조립동을","date":"2025-11-25T06:13:29.000Z","url":"https://www.chosun.com/economy/science/2025/11/25/YK5F35HRHNEBBJQ5EB5QESHA5M/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"환율, 4.7원 내린 1472.4원… 7거래일 만에 하락 마감","partialText":"25일 미국 달러 대비 원화 환율이 1470원대 초반으로 내려왔다. 미국 연방준비제도(Fed·연준)의 금리인하 기대감이 커지면서 달러 강세가 누그러진 데다, 위안·엔 등 아시아 통화들이 대체로 강세를 보인 영향이다. 외환당국의 시장 개입 경계감도 환율 하락에 힘을 보탰다. 이날 서울 외환시장에서 원·달러 환율은 전 거래일 주간거래 종가(오후 3시 30분 기","date":"2025-11-25T08:00:09.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/GQ3GCZJVHBTGIZJWME3DMNZTGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[비즈톡톡] 고정비 부담 속 비워뒀던 ‘브레이크 타임’ 활용 나선 외식업계","partialText":"점심과 저녁 사이에 비워뒀던 오후 3~5시인 ‘브레이크 타임(Break time)’이 외식업계의 새로운 매출 발생 지대로 떠오르고 있습니다. 통상적으로 이 시간대는 휴식을 위한 공백 시간이었지만, 최근에는 공백을 매출로 전환하는 전략적 시간대인 ‘스윙 타임(Swing time)’으로 활용하는 추세입니다. 고물가 시대에 인건비·임대료 등 고정비 부담이 커지면","date":"2025-11-25T08:00:00.000Z","url":"https://www.chosun.com/economy/market_trend/2025/11/25/GAYGMNDDGMZDINJRG43WIMDBMQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"티움바이오 항암 신약 ‘토스포서팁’, WHO 국제일반명 등재","partialText":"신약 연구개발(R&amp;D) 전문 바이오 기업 티움바이오는 세계보건기구(WHO)로부터 항암 신약 후보물질의 국제일반명(INN)을 승인받았다고 25일 밝혔다. WHO는 1953년 보건의료인과 환자가 의약품의 성분을 잘 구별해 오남용을 피할 수 있도록 INN 사용을 제안했다. INN은 보통 의약품을 개발한 회사명에 의약품의 주성분을 붙인다. 예를 들어 미국","date":"2025-11-25T07:53:59.000Z","url":"https://www.chosun.com/economy/science/2025/11/25/MFSDKZRQMRRWIMDCMMYDMYZRGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"코스콤, 탄소배출권 위탁매매 중계관리시스템 구축","partialText":"코스콤이 탄소배출권 시장의 위탁매매 제도 도입에 맞춰 중계관리시스템을 구축했다.  코스콤은 환경부 온실가스종합정보센터(GIR), 한국거래소(KRX) 등 관계기관과 협력해 배출권 위탁매매 제도 지원을 위한 중계관리시스템을 개발하고, 전날부터 서비스를 개시했다고 25일 밝혔다. 이 시스템은 올해 2월 시행된 정부의 배출권거래법 개정 내용을 반영해 구축됐다. 기","date":"2025-11-25T07:52:19.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/GI3TAOBSHA3DKY3GHAYTCNJQGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"구윤철 부총리, 내일 기자간담회서 ‘외환시장 안정’ 메시지 낼 예정","partialText":"","date":"2025-11-25T07:50:18.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/7BG2IJJTIRE7HM5IIJYHBAX5WM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"금투협, ‘2026년도 금융투자전문인력 자격시험 일정’ 발표","partialText":"금융투자협회는 25일 2026년도 금융투자전문인력 자격시험 일정을 확정해 발표했다.  금융투자전문인력시험은 금융투자업 종사자의 전문성과 윤리성 제고 등을 위해 도입됐다. 해당 업무를 수행하기 위해 반드시 합격해야 하는 법정자격시험과 일부 자율자격시험으로 구성돼 있다. 2026년도에는 올해와 동일하게 3종의 투자권유자문인력시험(증권·파생상품·펀드) 각 3회,","date":"2025-11-25T07:47:40.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/MRQWEMTEMQ4GKMRXMQ2GKNDCGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"DK아시아, ‘신검단 로열파크씨티II’ 5D 조경 세계조경가협회 어워드 수상","partialText":"DK아시아는 지난 14일 인도 뭄바이 지오 월드 컨벤션센터(JWCC)에서 열린 세계조경가협회(IFLA, International Federation of Landscape Architects)가 주관하는 ‘2025 IFLA APR LA &amp; LUMINARY AWARDS’에서 신검단 로열파크씨티Ⅱ로 ‘Honourable Mention’을 수상했다고 25","date":"2025-11-25T07:47:36.000Z","url":"https://www.chosun.com/economy/real_estate/2025/11/25/MYYTKODCMIZDSOBTME3DIYJXGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"한화투자증권, ‘2025 소비자권익대상’ 기업 부문 수상","partialText":"한화투자증권은 ‘2025년 소비자권익대상’ 기업부문을 수상했다고 25일 밝혔다. ‘소비자권익대상’은 사단법인 컨슈머워치가 주관하는 행사로, 서비스 혁신과 책임 경영으로 소비자 권익 보호와 선택권 확대에 기여한 우수 기업을 선정한다. 이번 시상에서 한화투자증권은 2018년 소비자중심경영(CCM) 인증을 최초 취득한 이후, 독립적 소비자보호 조직 운영과 고객","date":"2025-11-25T07:42:38.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/GNRGIZDFGU3DIMRUGM3DANLCMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"환율 1500원 앞두고… 정부, 기업·국민연금도 모자라 증권사까지 동원해 ‘방어전’","partialText":"","date":"2025-11-25T02:58:00.000Z","url":"https://www.chosun.com/economy/money/2025/11/25/LMJGP4MLJRFURBWVLVVF6WBYSM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"NH證, 3150억원 모험자본 공급… 혁신산업·중소기업 ‘투트랙’ 투자","partialText":"NH투자증권이 혁신산업과 중소·중견기업 관련 모험자본 투자를 3150억원 규모로 집행한다고 26일 밝혔다. NH투자증권은 이번 모험자본 투자가 첨단, 벤처, 기술기업 등 혁신 산업에 대한 기업 지원 및 지역 균형성장이라는 한국 금융의 전환 방향 기조에 맞춘 선제적인 투자라고 설명했다. 회사는 인공지능(AI)·반도체·딥테크 등 혁신 산업에 1000억원, 중","date":"2025-11-25T07:36:21.000Z","url":"https://www.chosun.com/economy/stock-finance/2025/11/25/HBSTKOJXGBRWIZJTMEYDSNJSGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"기사 쓰고 주가 띄웠다 112억 챙긴 기자 등 구속","partialText":"","date":"2025-11-23T15:46:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/24/SCJW2O54VZDMVHY3O3PSZ4KGGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"“TSMC, 대만에 2나노 공장 3곳 추가 건설… 42조원 투입 검토”","partialText":"대만 반도체 위탁생산(파운드리) 기업 TSMC가 2나노미터(㎚·1㎚=10억분의 1m) 공장을 7곳에서 10곳으로 확대할 계획인 것으로 전졌다. 대만 매체 자유시보는 소식통의 말을 인용해 TSMC가 최근 국가과학기술위원회(NSTC) 등 정부 부처와의 회의에서 인공지능(AI) 칩 수요 급증에 대응하기 위해 대만에 2나노 공장 3개를 추가로 건설할 계획을 공유","date":"2025-11-25T07:27:41.000Z","url":"https://www.chosun.com/economy/tech_it/2025/11/25/GM3TCMDDMEYDEZRWGY4DCNRXGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"與 사법행정 TF “법원행정처 폐지·퇴직 대법관 5년 수임 제한”","partialText":"더불어민주당이 법원행정처 폐지와 퇴직 대법관의 대법원 처리 사건 수임 5년 금지, 법관 징계처분 강화 등을 골자로 하는 사법행정 개혁 초안을 25일 공개했다. 하지만 반대 의견도 적지 않다. 민주당 사법정상화TF가 진행하는 입법 공청회에 토론자로 나선 이지영 법원행정처 사법지원총괄심의관(고법판사)은 “사법행정권 남용 사태 이후 8년 동안 사법부가 해온 노","date":"2025-11-25T06:34:05.000Z","url":"https://www.chosun.com/economy/economy_general/2025/11/25/MI4DMM3DGFRWENTCMMZTEODEHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"원안위 “항공사 피폭 관리 기준 충족”… 2400회 실측 결과 발표","partialText":"원자력안전위원회는 25일 서울 강서구 한국항공협회에서 국제선 운항을 하는 국내 항공사 10곳과 함께 항공 승무원의 우주 방사선 노출 관리 강화를 위한 간담회를 열었다고 밝혔다. 우주 방사선은 지상에서는 대기층이 대부분 걸러주지만, 항공기가 비행하는 고도에서는 대기 보호 효과가 약해져 평소보다 높은 방사선에 노출될 가능성이 있다. 특히 장거리·고위도 노선에","date":"2025-11-25T07:16:35.000Z","url":"https://www.chosun.com/economy/science/2025/11/25/GJRDKOJZGIZGEYJVMFRDOOJXGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"정주영 만난 드러커 “현장의 신이다” 고개 숙여","partialText":"","date":"2025-10-14T12:00:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/10/14/AWXLYG62PFBRJCVV4HQVP7HE34/"}]
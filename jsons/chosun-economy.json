[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"SK하이닉스, ADR 상장이라는 호재에도 8%대 하락...코스피 매도 사이드카 발동","partialText":"","date":"2026-07-13T00:20:33.000Z","url":"https://www.chosun.com/economy/money/2026/07/13/U3MAVYQVGFEHHH72FX4PPAEIGU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"美 ·이란 갈등 고조에도...달러 대비 원화 환율 1490원대","partialText":"","date":"2026-07-13T00:19:10.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/13/YFUMPPISGNDHHM3LTADKJUT334/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"현대엘리베이터 임원 전원, 회사 주식 1만4500주 장내 매수","partialText":"현대엘리베이터의 전체 임원진이 책임경영과 주주가치 제고를 내걸고 회사 주식을 매입했다. 13일 금융감독원 전자공시시스템에 따르면 조재천 현대엘리베이터 대표를 비롯한 임원 30여명은 지난 6일부터 한 주 동안 장내 매수 방식으로 회사 주식 약 1만4500주를 취득했다. 이번 주식 매입은 임원진의 자발적인 참여로 이뤄졌다. 현대엘리베이터는 경영진이 직접 주식을","date":"2026-07-13T01:51:25.000Z","url":"https://www.chosun.com/economy/industry-company/2026/07/13/HAZGMZJUMFSTSOLGGM4TQOLCGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"세계적 권위의 생명과학상 ‘HFSP 나카소네상’에 김빛내리 서울대 교수","partialText":"과학기술정보통신부는 2027년 휴먼프론티어사이언스프로그램(Human Frontier Science Program·이하 HFSP) 나카소네상(Nakasone Award) 수상자로 기초과학연구원(IBS) 김빛내리 RNA 연구단장(서울대 생명과학부 석좌교수)이 선정됐다고 13일 밝혔다. HFSP는 생명과학 분야의 혁신적이고 도전적인 국제 공동 연구를 지원하기 위","date":"2026-07-13T01:50:32.000Z","url":"https://www.chosun.com/economy/science/2026/07/13/HBRWIMDEGBSGEOJRHBRDINZSGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"HS화성, 278억원 규모 서귀포항 재정비 공사 수주","partialText":"HS화성이 제주특별자치도 서귀포항 재정비 공사를 수주했다고 13일 밝혔다. 이번 사업은 제주특별자치도 서귀포시 서귀포항 일원의 항만 재정비 공사로, 총 계약금액은 약 278억원이다. HS화성의 지분은 50%인 약 139억원이며, 영성토건, 청봉환경과 공동으로 사업을 수행한다. 공사기간은 착공일로부터 1372일이다. 공사는 여객부두 1선석(5000톤급·152","date":"2026-07-13T01:48:45.000Z","url":"https://www.chosun.com/economy/real_estate/2026/07/13/GUYWMMTGME4DINTGHAYDIZLGGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"당정, ‘미래대응기금’ 정부 입법 추진…“하반기 깊은 논의 필요”","partialText":"정부와 더불어민주당이 반도체 호황 등으로 발생한 초과세수를 활용하는 ‘미래대응기금’을 정부 입법으로 추진하기로 했다.  한정애 더불어민주당 정책위의장은 13일 오전 하반기 경제성장전략 당정협의 직후 기자들과 만나 미래대응기금과 관련해 “현재 정부와 논의 중이며, 법안은 정부 입법 형태로 추진할 예정”이라고 밝혔다. 미래대응기금은 예산 편성 대비 초과로 걷힌","date":"2026-07-13T01:44:41.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/13/MJTGMZTCG5SDIYZQMFSGEOJXG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[속보] 코스피 급락에 매도 사이드카 발동…장중 7200선 붕괴","partialText":"ㅤ","date":"2026-07-13T01:41:09.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/07/13/GZSDGYLBGFRGGMRUHE4TMMRVME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"국힘, 김용범 정책실장 경질 요구 “‘오징어 게임’ 증시 주범”","partialText":"","date":"2026-07-12T04:34:52.000Z","url":"https://www.chosun.com/politics/assembly/2026/07/12/FSR7NHGT7NCCBBIGD45CZGYQ5U/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"SK쉴더스, 프로스트 앤드 설리번 ‘아태 고객 가치 리더십’ 선정…“보안 전문성 인정 받아”","partialText":"SK쉴더스는 글로벌 시장조사 기관 프로스트 앤드 설리번(Frost&Sullivan)으로부터 ’2026 아시아태평양 고객 가치 리더십’에 선정됐다고 13일 밝혔다. 프로스트 앤드 설리번은 매년 고객 가치, 기술 경쟁력, 사업 성과, 성장 잠재력 등을 종합 평가해 부문별 우수 기업을 선정한다. ‘아시아태평양 고객 가치 리더십’은 아시아태평양 지역 다양한 산업","date":"2026-07-13T01:35:58.000Z","url":"https://www.chosun.com/economy/tech_it/2026/07/13/GVRGGYRVMQ3DGODBGQ4GMN3FMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"꼼수 임대료 인상 막는다… 민간임대주택 관리비 등 신고 의무화","partialText":"앞으로 민간임대주택을 운영하는 사업자는 집세를 계약할 때 관리비나 가전·가구 사용료 등을 투명하게 밝혀야 한다. 관리비 등을 올려 받아 실질적인 임대료를 몰래 인상하는 편법 행위를 차단하기 위해서다. 아울러 100가구가 넘는 임대단지의 임대료 인상률을 제한할 수 있는 권한이 광역지방자치단체까지 확대된다. 국토교통부는 이 같은 내용을 골자로 하는 ‘민간임대주","date":"2026-07-13T01:30:48.000Z","url":"https://www.chosun.com/economy/real_estate/2026/07/13/HE2TCNBXGM3GKYRVMFRTCNBVMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"SK하이닉스, 美 나스닥 입성...최태원·곽노정 오프닝 벨 울려","partialText":"","date":"2026-07-10T13:41:03.000Z","url":"https://www.chosun.com/economy/tech_it/2026/07/10/ZFFLGBXTURFPTMM5OXL6LSHMVM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"2년 연속 경영 평가 ‘B’ 금감원, 금융위에 경영 성과 적극 홍보","partialText":"금융위원회가 금융감독원에 대한 경영 평가를 진행 중인 가운데, 금감원이 미국 상호 관세 대응책 등 지난해 주요 성과 자료를 금융위에 전달했다. 금감원은 지난해 금융위로부터 지적받은 해외 업무 협업 부족 관련 사항도 올해 보완해 제출한 것으로 전해졌다. 금감원은 2023년부터 2년 연속 경영 평가에서 B 등급을 받았다. 13일 금융 당국에 따르면 금융위와 금","date":"2026-07-13T01:30:00.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/07/13/MUYTKNRQGBRTIM3FGRTGIOJTMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"산업부·고용부 ‘조선업 노사정협의체’ 출범… 숙련인력·원하청 격차 등 현안 논의","partialText":"정부가 조선업의 숙련인력 부족과 원하청 격차, 고용 불안 등 현안을 논의하는 노사정 상시 대화협의체를 출범시켰다. 산업통상부와 고용노동부는 13일 오전 10시 30분 서울 프레스센터에서 ‘조선업 노사정 협의체’ 발족식을 개최했다고 밝혔다. 발족식에 이어 운영협의체와 실무협의체 첫 회의도 열렸다. 발족식에는 전국민주노동조합총연맹 전국금속노동조합, 한국노동조합","date":"2026-07-13T01:30:00.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/13/HE3TENZWMIZTCMZRMJSDQZBWG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"GS건설-LG전자, ‘차세대 AI홈’ 공동개발한다","partialText":"GS건설이 LG전자와 손잡고 인공지능(AI)·로봇 기반 미래 주거 표준 만들기에 나선다. GS건설은 허윤홍 대표와 류재철 LG전자 사장이 참석한 가운데 서울 종로구 GS건설 본사에서 지난 10일 ‘차세대 AI홈’ 공동개발을 위한 업무협약(MOU)을 체결했다고 13일 밝혔다. 이번 협약은 지난 4월 체결한 ‘미래형 주거 로봇 서비스 모델 구축’ 업무협약에 이","date":"2026-07-13T01:28:27.000Z","url":"https://www.chosun.com/economy/real_estate/2026/07/13/GBRTGMBRHE2TOZBUMIYTIYRZGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"금융당국 제동에도 은행 점포 축소 재개…은행대리업, 지점 통폐합 명분될까 ‘촉각’","partialText":"","date":"2026-07-13T00:52:26.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/13/67F2MZAS6NCFLBBHAQWCRN7RZ4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘추가 세수’ 쓰는 미래대응기금…오늘 특별법 청사진 제시","partialText":"이재명 대통령이 13일 청와대에서 이른바 ‘추가 세수’ 사용 계획을 논의하기 위한 국가재정전략회의를 주재한다. 반도체 산업 호황에 따라 향후 수 년 간 세수가 증가할 것으로 보고, 기존 법정 용어이자 사용처가 명시된 ‘초과 세수’ 대신 ‘추가 세수’ 개념을 특별법상 신설해 지방균형발전·청년 정책 등에 쓰는 게 골자다. 이날 회의에서 대략적인 밑그림을 제시한","date":"2026-07-13T01:27:51.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/13/MQ2DOZJUME4GCNBUG5SDAYJQG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"다쏘시스템, 글로벌 디자인·혁신 경진대회 ‘아크루티’ 개최","partialText":"다쏘시스템은 전 세계 학생을 대상으로 하는 ‘제16회 아크루티(AAKRUTI) 혁신 경진 대회’를 개최한다고 13일 밝혔다. 이번 아크루티는 로보틱스, 지역사회 문제 해결, 헬스케어 혁신, 모빌리티 등 4개 주제로 진행된다. 참가 학생들은 디자인 사고와 엔지니어링 원리를 바탕으로 현실의 문제를 해결할 수 있는 프로젝트를 개발하게 된다. 프로젝트에는 다쏘시스","date":"2026-07-13T01:27:24.000Z","url":"https://www.chosun.com/economy/tech_it/2026/07/13/MRTGCOJUGU3GMNBTGJQTAYTBMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"쿠팡은 ‘페이’, 네이버는 ‘물류’로… 서로의 아성 넘보는 이커머스 양강","partialText":"","date":"2026-07-10T09:32:31.000Z","url":"https://www.chosun.com/economy/market_trend/2026/07/10/JP4364VE3FEFHJ3URBV4BAQOSU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"중앙일보, 워크아웃 개시... 채권단 75% 이상 ‘찬성’","partialText":"","date":"2026-07-10T09:26:04.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/10/A2G5KHOHUBCCVOLMHCARDHFHK4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"호반건설, 한진칼 지분 20% 넘겨... 조원태 회장 측과 0.42%p차","partialText":"","date":"2026-07-10T09:03:46.000Z","url":"https://www.chosun.com/economy/industry-company/2026/07/10/XOHIEO4W7FGCZKY4ZMVF6SE5SA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"실외기 없는 이동형 에어컨, 16도까지 온도 확 낮추는데 36만원대 특가","partialText":"","date":"2026-07-13T01:24:30.000Z","url":"https://www.chosun.com/economy/startup_story/2026/07/13/OPF25QUGERFDLCVD2OLD3A5DVU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"이찬진 “연기금 위탁운용사 평가 강화”…금투협 “의결권 행사 내실화” 화답","partialText":"금융감독원이 국내 연기금의 위탁운용사 평가에서 수탁자책임 활동의 평가 비중을 확대하겠다고 다시 한 번 강조했다. 자산운용사들의 의결권 행사와 주주권 활동을 보다 실질적으로 평가하겠다는 취지다. 금융투자협회도 의결권 행사 체계를 형식이 아닌 실질 중심으로 개선하겠다고 화답했다.  이찬진 금융감독원장은 13일 금융투자협회에서 열린 자산운용사 최고경영자(CEO)","date":"2026-07-13T01:23:17.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/07/13/MRSTKMLDMFSWCYLFHA3TQOBTME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"어도비, 디즈니 테마파크 설계에 ‘파이어플라이 파운드리’ 적용","partialText":"어도비가 월트 디즈니 이매지니어링과 손잡고 디즈니 파크의 디자인 및 사전 제작에 생성형 인공지능(AI) 기술을 도입한다고 13일 밝혔다. 이번 협업에는 기업이 자사 브랜드와 콘텐츠에 특화된 생성형 AI 모델을 구축할 수 있도록 지원하는 ‘어도비 파이어플라이 파운드리’가 활용된다. 디즈니 이매지니어들은 기존 어도비 디자인 도구와 작업 환경에서 해당 모델을 활","date":"2026-07-13T01:16:35.000Z","url":"https://www.chosun.com/economy/tech_it/2026/07/13/MY3DSOBZMI3TCMJVGJRGKY3DGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"구글클라우드, 삼성전자 DX부문에 ‘제미나이 엔터프라이즈’ 공급","partialText":"구글클라우드는 한국을 포함한 전 세계 삼성전자 DX부문 임직원을 대상으로 제미나이 엔터프라이즈를 도입한다고 13일 밝혔다. 구글클라우드가 국내에서 추진한 기업용 에이전틱 인공지능(AI) 도입 사례 가운데 최대 규모다. 제미나이 엔터프라이즈는 사내 데이터와 업무 시스템을 연결해 임직원이 필요한 정보를 검색·분석하고 업무에 활용할 수 있도록 지원하는 기업용 A","date":"2026-07-13T01:14:14.000Z","url":"https://www.chosun.com/economy/tech_it/2026/07/13/GQYGMYLBHA4DCNTCGNRDAOJQMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"폭우와 강풍에 끄떡없는 108 살대 3단 자동 우산, 1만4000원 초특가","partialText":"","date":"2026-07-13T01:13:50.000Z","url":"https://www.chosun.com/economy/startup_story/2026/07/09/IT7U2M5FMZDZNOOEYV757HWXOA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"놀유니버스, 日 호텔 유통사 애플월드와 맞손…국내 숙소 3만곳 공급","partialText":"놀유니버스가 일본 호텔 유통 전문기업 애플월드(Apple World Inc.)와 전략적 파트너십을 맺고 국내 숙박 상품의 일본 유통 확대에 나선다. 놀유니버스는 자사가 보유한 국내 숙박 인벤토리 약 3만곳을 애플월드의 일본 여행사 및 글로벌 판매 네트워크에 공급한다고 13일 밝혔다. 이번 협력은 일본 기업과 체결한 첫 글로벌 호텔 유통 파트너십이다.  국내","date":"2026-07-13T01:12:57.000Z","url":"https://www.chosun.com/economy/market_trend/2026/07/13/HAZDANLFGQYDSOBXMZTDGZBRGU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘파산 기로’ 홈플러스, 13일부터 전 점포 임시 휴업","partialText":"홈플러스가 13일부터 대형마트 매장 문을 닫는다. 홈플러스는 운영자금 고갈과 시설 유지·관리의 어려움으로 이날부터 대형마트 임시휴업에 들어가기로 결정했다고 밝혔다. 다만 몰 부문은 입점주들이 원하는 경우 영업을 계속하기로 했다. 홈플러스 측은 “운영자금이 모두 고갈돼 상품 대금 지급은 물론 유틸리티 비용 등 매장을 유지하기 위한 운영비조차 감당할 수 없는","date":"2026-07-13T01:12:17.000Z","url":"https://www.chosun.com/economy/market_trend/2026/07/13/MQYDMNBQGFSTAMZZGNRTQZBSGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"5대 금융지주, 상반기 포용금융 11.3조 공급…2.3조원 규모 채무조정도","partialText":"","date":"2026-07-12T03:17:25.000Z","url":"https://www.chosun.com/economy/economy_general/2026/07/12/MH2CKLTXRJAUPCFJZACAPPW3IQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"82세에 우주 문턱 넘은 美 여성 조종사 하늘로","partialText":"","date":"2026-07-10T15:35:00.000Z","url":"https://www.chosun.com/economy/science/2026/07/11/2HFAASLKWRA6FMUCWVBG5TBF7M/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"현대연 “미국 적정금리 하반기 4%대 진입… 긴축 충격 대비해야”","partialText":"","date":"2026-07-12T03:02:45.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/07/12/EU3WY3FXAZBFRKS2KJN3S6WQ24/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"코스피 공포지수 최근 1년간 251% 증가...증권가 ‘외인 컨트롤론’ 부상","partialText":"","date":"2026-07-13T00:40:28.000Z","url":"https://www.chosun.com/economy/money/2026/07/13/NO6YWRMMSFD3TOE5JUMEQC2SJQ/"},{"spec":{"publisher":{"id
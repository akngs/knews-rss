[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"앤트로픽, 한강·황석영 등 한국 작가 작품 AI 학습에 무단 활용","partialText":"미국 인공지능(AI) 기업 앤트로픽이 한강과 황석영 등 한국 작가들의 작품을 자사 AI 챗봇 ‘클로드(Claude)’ 학습에 무단으로 활용한 정황이 드러났다.  17일 한국문학번역원은 앤트로픽의 저작권 침해 소송 관련 합의 사이트에 공개된 보상 대상 도서 목록에서 한국 작가들의 작품 21종을 확인하고 해당 작가들에게 이 사실을 통보했다고 밝혔다. 앤트로픽은","date":"2026-10-17T01:46:27.000Z","url":"https://www.chosun.com/economy/tech_it/2026/10/17/MY3DGMDBHAZWCMBTME3DIYLCGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"찰보리빵 꽂혀서 영광 넘어간 거제 피자 갑부, 150만개 판매 대박","partialText":"","date":"2026-10-17T01:45:44.000Z","url":"https://www.chosun.com/economy/startup_story/2026/10/18/REWLA6WMPVBV3EHD4GLU7WSMKM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[스타트UP] “어린이 숏폼 넘어 성장 플랫폼으로” 키즐링, AI로 어린이 대회 운영·심사 자동화","partialText":"키즐링은 어린이가 직접 영상을 만들고, 숏폼 챌린지와 온라인 대회에 참여할 수 있도록 지원하는 플랫폼이다. 초기에는 알파세대 전용 숏폼 플랫폼으로 출발했지만 현재는 학교·기업·공공기관·협회 등이 챌린지와 공모전, 온라인 대회를 운영할 수 있는 기업간거래(B2B)·기업과 정부·기관 간 거래(B2G) 서비스형 소프트웨어(SaaS)로 사업 영역을 확대하고 있다.","date":"2026-10-17T00:45:40.000Z","url":"https://www.chosun.com/economy/smb-venture/2026/10/17/HBSDKY3CME3TGYJUGQ2TIZBSMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"코스피 7거래일 연속 하락에 반대매매 3000억원 육박","partialText":"코스피가 7거래일 연속 하락하는 동안 빚을 내 주식에 투자한 개인 투자자들의 반대매매 금액이 3000억원에 육박한 것으로 나타났다. 국내 증시의 변동성이 커지면서 채권과 미국 주식으로 향하는 개인 투자자들의 자금도 늘고 있다.  17일 금융투자협회에 따르면 지난 6일부터 15일까지 위탁매매 미수금 대비 실제 반대매매 금액은 누적 2981억원으로 집계됐다.","date":"2026-10-17T00:43:12.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/10/17/GVRWIZRUMM2TMOBYMVRTEYTCME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"두산 재무통 전진배치… 김민철·박상현 부회장","partialText":"","date":"2026-10-16T15:44:00.000Z","url":"https://www.chosun.com/economy/industry-company/2026/10/17/72F3P2RZO5HQPM35TPOQWLJC7I/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"코스피 7거래일 하락에 ‘빚투’ 직격탄…반대매매 3000억 육박","partialText":"","date":"2026-10-17T00:30:51.000Z","url":"https://www.chosun.com/economy/economy_general/2026/10/17/6YENIOK6NZHZLP67JHRONBDIQY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"“AI 집중된 한국경제, 취약성도 점점 커져”","partialText":"","date":"2026-10-16T15:44:00.000Z","url":"https://www.chosun.com/economy/economy_general/2026/10/17/MIOIKMFDYJHNNGZKBUIGAJXPW4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"“단일종목 레버리지 신중해야” 보고서 무시하고 출시","partialText":"","date":"2026-10-16T15:44:00.000Z","url":"https://www.chosun.com/economy/stock-finance/2026/10/17/IVJS2GZJSVD6BEK7ETLXZPO3F4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categ
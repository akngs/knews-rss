un.com/economy/money/2025/04/28/WWLS3RP7WX7HOVQTDC4VGYAQHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"스타트업 업스테이지, AI 선도할 100대 기업에","partialText":"","date":"2025-04-27T15:51:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/04/28/2NFGLM5H5NC5BBIZZBEYUM3YVY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"임원 평균연봉 1010만원 깎였고, 직원은 544만원 올랐다","partialText":"","date":"2025-04-27T15:51:00.000Z","url":"https://www.chosun.com/economy/industry-company/2025/04/28/XAA7C4PQ7JAS3E3Q3J5CNZKGOE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"AI 인재 쟁탈전… 토스 “면접만 봐도 100만원 드려요”","partialText":"","date":"2025-04-27T15:50:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/04/28/ZUE55YUCRNGSBLUO6DEQSMJ52Y/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"외국인, 주식 ‘셀 코리아’… 한국 채권은 ‘폭풍 매수’","partialText":"","date":"2025-04-27T15:50:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/04/28/NLSHMUL6FNERBLZNRC7MFY4B3U/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"美도 규제하는 ‘MS 끼워팔기’… 공정위는 손 놓고 있어","partialText":"","date":"2025-04-27T15:50:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/04/28/4NGDIR5RTFBJNOXUC6T4KDDZZE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[모닝] 5월 초 황금연휴 앞두고 해외 패키지 예약 40% 증가","partialText":"","date":"2025-04-27T15:50:00.000Z","url":"https://www.chosun.com/economy/market_trend/2025/04/28/RUXRZMCDKRCCJMNCJTZNMG4CDQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"미성년자에 19금 채팅, 욕설까지… ‘성인용 AI’로 돈벌이 나선 빅테크","partialText":"","date":"2025-04-27T15:50:00.000Z","url":"https://www.chosun.com/economy/tech_it/2025/04/28/Y4QLXOAGAJCNPKCNBA3FQUCLWU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"BNK證 “LG전자, 거시 환경 불확실성 높아… 목표주가 20% 하향”","partialText":"BNK투자증권은 27일 LG전자에 대해 미국의 상호관세 부과 등 거시 환경 불확실성에 따른 영향이 점차 나타날 전망이라고 분석했다. 이에 따라 투자의견은 ‘매수’를 유지하면서도 목표 주가를 기존 12만원에서 9만6000원으로 20% 하향 조정했다. LG전자는 올해 1분기 LG이노텍을 제외한 별도 기준 매출액 17조9100억원, 영업이익은 1조1300억원을","date":"2025-04-27T22:10:08.000Z","url":"https://www.chosun.com/economy/money/2025/04/28/OVEBMFL3DVVSXYIYFJAQFOSWZQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"발볼 넓은 한국인에 딱 맞춰, 걷는 데 최적화된 신발","partialText":"","date":"2025-04-27T20:10:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/04/28/VRJZ2YFKPRBSFNOVQQ2JVCAJCM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"제철 맞아 알 꽉 찬 주꾸미 조선몰 단독 특가","partialText":"","date":"2025-04-27T20:30:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/04/28/WI54BEHXA5AO5BNGW5TUTPMG3M/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[사이언스샷] 달 기지에서 스테이크 먹나…배양육 실험장치 우주行","partialText":"여행을 떠나면 금방 집밥이 그리워진다. 하물며 지구를 떠나 수개월, 수년씩 걸리는 우주여행이라면 더 그럴 것이다. 안 그래도 우주에 가면 입맛을 잃기 쉬운데 지구에서 가져온 밥도 모두 동결 건조 식품이라 금방 질린다. 과학자들이 우주인의 입맛을 살릴 방법을 찾고 있다. 지구에서 가져가기 힘들다면 우주에서 직접 만들어 먹는 방식이다. 국제우주정거장(ISS)과","date":"2025-04-27T21:00:01.000Z","url":"https://www.chosun.com/economy/science/2025/04/28/PYH5R422DTXQMH2XXGVH5X4WUA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"올해 기념일 선물로 ‘공항’을 줄게 [사이공모닝]","partialText":"","date":"2025-04-27T21:00:01.000Z","url":"https://www.chosun.com/economy/market_trend/2025/04/28/DYFOVHY7YBF7FGJEGYSAWYWKAY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"\"임대 줄이려 끈질긴 줄다리기\" 일반분양 180가구 늘린 목동5단지 위원장의 노력","partialText":"[땅집고] “재건축은 시작부터 입주까지 적어도 10년의 여정을 소유주들의 신뢰와 동의로 진행하는 사업이다. 소유주 권익을 보호하는 것을 최고의 가치로 생각하고, 신탁 방식으로 재건축을 추진해 사업 기간을 최대한 단축하는 것이 목표다.” (이승원 목동5단지 재건축추진준비위원회 위원장)  서울 양천구 목동 ‘목동신시가지 5단지’(☞단지정보 알아보기)는 지난 1","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/realty/redevelop/2025/04/28/5W6ZYU7HTCG5IYNQEGOXACQYDY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"1분기 ABS 발행액 8조3000억원…전년 동기 대비 43.8% 급감","partialText":"올해 1분기 대출채권·매출채권 기초 ABS, 회사채 기초 유동화보증(P-CBO) 발행이 전년 동기 대비 모두 감소한 것으로 집계됐다. 금융감독원은 올해 1분기 자산유동화증권(ABS)의 발행 금액이 8조3000억원으로 전년 동기 대비 43.8%(6조5000억원) 감소했다고 25일 밝혔다. ABS는 부동산, 채권, 유가증권 등 유·무형 자산을 기초로 발행된 증","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/money/2025/04/28/7D4QFSM62COL32OO7FUZXSLSSM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"대박 아니면 쪽박… 정치테마株 유상증자 주관 나선 SK증권","partialText":"조기 대선 국면에 정치테마주로 지목되면서 주가가 급등한 상장사들이 잇따라 유상증자에 나섰는데, 이들의 유증 주관을 모두 SK증권이 맡아 눈길을 끈다. 중소형 상장사의 유상증자 주관을 적극적으로 맡는 SK증권이 이번엔 정치테마주를 통한 청약 흥행을 기대하는 모습이다. 하지만 SK증권이 유상증자 주관 과정에서 실권주를 떠안으며 오히려 손실을 볼 가능성도 있다.","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/money/2025/04/28/4WLKSHSXM35ZYC66RIFXDS45ZI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"서민들 최후의 선택인데… 카드 리볼빙 금리 19% 육박","partialText":"서민들의 급전 대출 창구인 카드론 금리가 2022년 ‘레고랜드 사태’ 이후 최고 수준으로 치솟은 데 이어 리볼빙 금리(수수료율)도 고공 행진을 이어가고 있다. 2022년 15% 후반이던 리볼빙 금리는 올해 17%까지 상승하며 좀처럼 내려올 기미를 보이지 않고 있다. 저신용자에게 적용되는 금리는 19%에 육박한 지 오래다. 리볼빙은 신용카드 사용자가 갚아야","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/money/2025/04/28/TRLUYIKC4UYWWWL2DPUIE7F67E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[딥테크 점프업] “약대생, 빅파마 같이 쓰는 AI…신약 후보 찾고 설계, 합성까지 서비스”","partialText":"“우리는 누구나 직접 써보고, 실체를 확인할 수 있는 인공지능(AI) 플랫폼을 만듭니다. 앞으로 AI 신약개발 생태계를 조성해, 약대생부터 연구기관, 제약사까지 모두 경쟁력을 높이는 게 꿈입니다.” 지난 22일 서울 강남구 히츠(HITS) 본사에서 만난 김우연 대표는 최근 출시한 신약개발 AI인 ‘하이퍼랩(HyperLab) 2.0’을 이같이 소개했다. 한국","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/science/2025/04/28/2JX3PPR4NDVKKGGI2JHPW6WTIY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"한남2 조합 \"대우건설 믿고 간다\" 시공권 두번째 재신임 통과","partialText":"[땅집고] 서울 용산구 한남2구역재정비촉진구역이 대우건설의 시공사 지위를 유지하기로 결정했다. 대우건설은 시공권을 따낸 후 조합 측과의 갈등으로 2023년 한 차례 재신임을 받았고, 최근 두번째 재신임 투표를 통과해 다시 한번 시공권을 유지하게 됐다. ☞나에게 딱 맞는 아파트, AI가 찾아드립니다 27일 정비업계 등에 따르면 이날 오후 진행한 한남2구역 조","date":"2025-04-27T21:00:00.000Z","url":"https://www.chosun.com/economy/realty/redevelop/2025/04/28/KVDZJOQNDVNSSXPCAK2QNAUSCA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"‘초고반발에 높은 관용성’ 10만원대 드라이버, 8만원대 우드","partialText":"","date":"2025-04-27T20:40:00.000Z","url":"https://www.chosun.com/economy/startup_story/2025/04/28/DGUAQK6S45BI7FY3ZDQTLOGI7Y/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"2년前 LG유플 29만명 털렸지만… ‘폰 복제’ 피해 없었다","partialText":"","date":"2025-04-27T15:55:00.000Z","url":"https://www.chosun.com/economy/industry-company/2025/04/28/KZRVQEOJTBEJZKBXBTAW5N7IVE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/ou
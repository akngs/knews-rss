com/economy/weeklybiz/2025/03/06/ZTTSLLDJFZH5TDUEDK2BQZLSCQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"“美 원전 생태계 붕괴, 건설 역량 갖춘 한국과 협력 필수적\"","partialText":"","date":"2025-03-06T08:32:01.000Z","url":"https://www.chosun.com/economy/weeklybiz/2025/03/06/46KF236WIFEVJP6S6QJRPHBPLY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"트럼프 책상에 한미 FTA 폐기 서류 다시 올라온다면","partialText":"","date":"2025-03-06T09:23:54.000Z","url":"https://www.chosun.com/economy/weeklybiz/2025/03/06/I3HKS2HOYFAHJCSNQA6623LA4Q/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"부부상속세 폐지 땐 ‘先배우자 後자녀’ 상속이 관행될 듯","partialText":"","date":"2025-03-07T16:00:00.000Z","url":"https://www.chosun.com/economy/economy_general/2025/03/08/LX52XUDKCZCXRFK5RCDZMTWJFU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"협력사들 납품 재개… 한숨 돌린 홈플러스","partialText":"","date":"2025-03-07T15:53:00.000Z","url":"https://www.chosun.com/economy/industry-company/2025/03/08/UCNQ4GTIQNBYBDICTDJE33NUPY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"방산·고배당 ETF로 재미보긴 했는데... 한화운용, 점유율은 뒷걸음질","partialText":"방산·조선주 주가가 연초부터 상승 곡선을 탄 가운데 한화에어로스페이스, 한화오션 등 자사 그룹주와 해외 방산주를 담은 한화자산운용의 상장지수펀드(ETF) 주가가 오름세다. 한화운용은 지난해 말 그룹사 강점을 활용한 방산·조선주 중심 ETF를 출시, 개인 투자자들의 자금이 몰리면서 연초 좋은 성과를 내고 있다. 하지만 시장 점유율은 최근 1년 사이 6위에서","date":"2025-03-07T21:00:01.000Z","url":"https://www.chosun.com/economy/money/2025/03/08/ITZG6XFNTBGLKGJRY6I62TCUOU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"초단기 옵션 커버드콜 ETF에 돈 몰리지만… ‘제 살 깎아’ 분배금 줄 가능성도","partialText":"높은 월 분배율 덕분에 초단기 옵션을 활용한 커버드콜 상장지수펀드(ETF)에 투자 자금이 몰리고 있지만, 시장 변동성이 커지면서 원금 손실 가능성에 주의해야 한다는 경고가 나온다. 특히 커버드콜 ETF 대부분이 미국 자산을 기초로 삼고 있어 미국 증시가 급등락하면 직격탄을 맞을 수 있다. 커버드콜이란 주식을 보유하면서 그 주식을 미리 정한 가격에 살 수 있","date":"2025-03-07T21:00:01.000Z","url":"https://www.chosun.com/economy/money/2025/03/08/DSLFXQIARYIRPA6XKSGIGRDACM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[주간코인시황] 관세 압박·지정학 우려에 하락하는 가상자산","partialText":"2025년 3월 첫째 주 가상자산 시장은 지난주 과대 낙폭에 따른 반발 매수세로 초반 큰 폭의 반등이 나타났으나, 이어진 미국 관세정책의 혼선과 글로벌 무역 불확실성 확대로 상승폭 대부분을 반납했다. 그럼에도 트럼프 대통령이 전략적 비축 자산으로 언급한 일부 종목이 크게 오르며 종목별 온도차가 두드러졌다. 비트코인은 전주 대비 약 2% 상승하여 8만6000","date":"2025-03-07T21:00:00.000Z","url":"https://www.chosun.com/economy/money/2025/03/08/BW7YGTCFRSXOTJ7YBHQYPUQC6Y/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"[의료최전선 외상센터]⑦ “인구 20% 서울에 중증외상센터 단 한 곳,  지역센터 설립해 분담하자”","partialText":"권역외상센터는 각 지역에서 발생하는 중증외상 환자를 치료하는 임무를 맡은 의료기관이다. 권역별로 전국에 17곳이 지정돼 있다. 교통사고, 낙상, 산업재해로 중증 외상을 입은 환자들이 이 곳에서 치료받아 새 삶을 찾고 있다. 권역외상센터가 2012년부터 국내에 본격적으로 설립되면서 국내 외상 환자의 사망률은 빠르게 감소하고 있으나, 아직 갈 길은 멀다. 여전","date":"2025-03-07T21:00:00.000Z","url":"https://www.chosun.com/economy/science/2025/03/08/CGUT7SWCQJ5AVTJFF4EOTL26J4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"\"환급금만 무려 11억, 목동7단지 8년 안에 49층 랜드마크로 재건축\"","partialText":"[땅집고] “목동 7단지는 목동 14개 단지 중에서도 가장 중심부에 위치하고 있습니다. 어느 단지도 갖지 못한 역세권 단지인데다, 학군도 최고죠. '대장 아파트'라는 타이틀에 걸맞게 목동 일대 최고의 아파트로 만들 겁니다.” (지성진 목동신시가지 7단지 재건축추진준비위원회 위원장) 서울 양천구 목동의 ‘목동신시가지 7단지’(☞단지정보 알아보기)는 '입지 깡","date":"2025-03-07T21:00:00.000Z","url":"https://www.chosun.com/economy/realty/redevelop/2025/03/08/LAYTAM74FECASV2H452NNBHUGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"안방서 축구 경기 볼 수 있다는 인천 아파트 \"경기 직관이 공짜네!\"","partialText":"[땅집고] 최근 온라인 축구 커뮤니티에서는 집 안에서 K리그 경기를 관람할 수 있는 인천의 아파트가 화제가 되고 있다. 축구팬들은 “저 아파트에 살면 내 집 안방에서 K리그 경기를 볼 수 있겠다”며 부러움을 표했다. 이 단지는 인천 미추홀구 숭의동에 위치한 ‘서희스타힐스 스타디움 센트럴시티’(☞단지정보 알아보기)다. 2022년 4월 입주한 이 단지는 최고","date":"2025-03-07T21:00:00.000Z","url":"https://www.chosun.com/economy/realty/apartment/2025/03/08/P3TN63L4F6Y4BGL77BHUC6CVIE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title":"금값 계속 안 올라도, 금 투자로 돈 버는 방법이 있다","partialText":"","date":"2025-03-07T20:50:00.000Z","url":"https://www.chosun.com/economy/money/2025/03/08/RTOXTYFNOVH6LOWIFAICQLV7WQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"경제","categories":["economy"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/economy/?outputType=xml"},"title
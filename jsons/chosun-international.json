un.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美, 이란 돈줄 차단… ‘경제적 분노’ 작전","partialText":"","date":"2026-04-16T15:52:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/3P2U2OQ7LNB67LDKEMW2XDODHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"종전협상 막판 변수 ‘동결 자산’… 이란 “묶인 1000억달러 풀어라”","partialText":"","date":"2026-04-16T15:52:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/H6KTLTUIORGQPHPK5STPFDFJJI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"송영길 前대표, 美의회서 ‘한반도 종전선언’ 주장 인사 만나","partialText":"","date":"2026-04-16T21:46:05.000Z","url":"https://www.chosun.com/international/us/2026/04/17/MJVD3RHKXBAYPPMU3C4DLQ55AI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"S&P500·나스닥 이틀 연속 최고치...트럼프 “이슬라마바드 갈 수도”","partialText":"","date":"2026-04-16T20:06:48.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/2WEKC5NZHBGOTHVFG7FZNPBAAM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “이란과 주말에 회담할 수도, 필요하면 휴전 연장”","partialText":"","date":"2026-04-16T19:10:09.000Z","url":"https://www.chosun.com/international/us/2026/04/17/AZMWA3RPRJDZXAZP7PHXDPJXPU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"미군이 준 155㎜ 야포… 땅을 뒤집어 놓는 막강한 화력","partialText":"","date":"2026-04-16T18:00:00.000Z","url":"https://www.chosun.com/international/china/2026/04/17/SCKCLRZL55C25MLSBGU3AK4X7Q/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"FBI 이메일까지 털렸다… 휴전 뒤 더 교묘해진 이란 해킹","partialText":"미국과 이란의 휴전 이후에도 이란 해커들은 공격을 멈추지 않고 있다. 오히려 더 은밀하고 교묘한 방식으로 침투를 시도하고 있다는 분석이 나온다.  뉴욕타임스(NYT)는 지난 8일 이란과 미국 사이의 휴전이 발효된 이후에도 이란 측의 사이버 작전이 지속되고 있다고 16일(현지 시각) 보도했다. 최근 이란 해커들의 행보는 과거의 과시형 공격과는 양상이 다르다.","date":"2026-04-17T00:21:15.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/GYZGGOJXMZSTQYZTMQZWGNJSGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘·레바논, 평화협정 위해 열흘간 휴전…78년 만에 숨고르기","partialText":"미국의 중재로 이스라엘과 레바논이 평화 협정 체결을 위한 열흘간의휴전에 들어갔다.  휴전은 미 동부 시각 기준 16일(현지 시각) 오후 5시부터 공식 발효됐다. 한국 시각으로는 17일 오전 6시에 해당한다. 앞서 도널드 트럼프 미국 대통령은 트루스소셜에 “조셉 아운 레바논 대통령과 베냐민 네타냐후 이스라엘 총리와 훌륭한 대화를 나눴다”며 휴전 사실을 알린","date":"2026-04-16T22:34:31.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/GU3TAY3GHE3TMODEMY3DKMJZMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[별별세상] 12세 아동도 종신형 가능… 엘살바도르, 초강력 ‘범죄와의 전쟁’","partialText":"","date":"2026-04-16T15:45:00.000Z","url":"https://www.chosun.com/international/mideast-africa-latin/2026/04/17/JESLMRC6XVFTPOTFZR65LZRHBE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “美·이란, 주말에 다음 협상 열릴 수도…합의에 매우 근접”","partialText":"도널드 트럼프 미국 대통령은 미국과 이란의 다음 협상이 주말 중으로 열릴 수도 있다고 말했다.  16일(현지 시각) 트럼프 대통령은 백악관에서 취재진을 만나 “이란과의 협상에 많은 진전이 있고 합의에 매우 근접했다”며 “지난 7일 합의된 ‘2주 휴전’이 연장될 필요가 있는지 모르겠다”고 말했다. 미국과 이란의 휴전은 21일까지로, 양측은 지난 11일 파키스","date":"2026-04-16T22:08:22.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/MVRTSMBZMMYDSZBWGE2TCZLFGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호르무즈 통항 위한 英·佛 주도 40개국 회의 개최…李 대통령도 참석한다","partialText":"중동 전쟁으로 차단된 호르무즈 해협에서의 자유로운 통항을 위한 국제 정상 회의가 영국·프랑스 주도로 열리는 가운데, 우리 정부도 참석을 확정 지었다.  16일(현지 시각) 영국 총리실은 키어 스타머 영국 총리와 에마뉘엘 마크롱 프랑스 대통령이 17일 오후 약 40개국 대상으로 ‘호르무즈 해협 해상 항행의 자유 이니셔티브’ 화상 회의를 공동 주재한다고 밝혔다","date":"2026-04-16T21:59:22.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/MMYTEMRUGBSDAZRTGE4TOZJSGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"종전 기대감에 뉴욕증시 상승 마감…S&P500·나스닥 이틀 연속 최고치 기록","partialText":"스탠더드앤드푸어스(S&P) 500 지수와 기술주 중심의 나스닥 종합지수가 이틀 연속 사상 최고치 기록을 경신했다.  16일(현지 시각) 뉴욕 증시에서 다우존스30 산업평균지수는 전장보다 115.0포인트(0.24%) 오른 4만8578.72에 거래를 마쳤다. S&P 500 지수는 전장보다 18.33포인트(0.26%) 오른 7041.28에, 기술주 중심의 나스닥","date":"2026-04-16T21:38:30.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/MRQTQYZWGIYWMOLDMFSTQMJVME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “이스라엘·레바논, 10일간 휴전 합의”","partialText":"도널드 트럼프 미국 대통령이 16일(현지 시각) 이스라엘과 레바논이 10일간의 휴전에 합의했다고 밝혔다. 트럼프 대통령은 이날 트루스소셜에 “조셉 아운 레바논 대통령과 베냐민 네타냐후 이스라엘 총리와 훌륭한 대화를 나눴다”며 “양국 정상은 두 나라 간 평화를 이루기 위해 미국 동부시간 오후 5시부터 공식적으로 10일간의 휴전에 들어가기로 합의했다”고 밝혔다","date":"2026-04-16T15:55:30.000Z","url":"https://www.chosun.com/international/international_general/2026/04/17/MEYWCMTCHFQWMMZVHAZTGOJVHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美항모 3척 모두 중동 간 사이... 中, 남중국해에 ‘부유식 장벽’","partialText":"","date":"2026-04-15T19:46:15.000Z","url":"https://www.chosun.com/international/us/2026/04/16/TNW2ZT7EMNE7JPHAQ6TMUN5K6A/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"뉴욕증시, 레바논·이스라엘 대화 불발에 하락세 출발","partialText":"미국과 이란의 종전 합의에 대한 기대가 위축되면서 뉴욕 증시 3대 주가지수가 하락세로 출발했다. 16일(현지 시각) 오전 9시 57분 뉴욕증권거래소에서 다우존스30산업평균지수는 전장보다 29.27포인트(0.06%) 내린 4만8434.45를 기록 중이다. 스탠더드앤드푸어스(S&P)500지수는 7015.30, 나스닥 종합지수는 2만3929.18이다. 각각 전장","date":"2026-04-16T14:41:02.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GIZTQYJSHFTDSY3FGU4GGOJZHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美, 무기 재고 ‘빨간불’… GM·포드에도 “무기 만들어라”","partialText":"","date":"2026-04-16T08:00:15.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/HSWPW7DI5BEPDDBAVQVU7OS34I/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"독일 정치권, 원전 재가동 두고 “신설보다 저렴” vs “비싸고 위험”","partialText":"최근 독일 정치권에서 원자력 발전소를 다시 가동해야 한다는 주장이 제기된다. 여론은 원전 재가동을 찬성하는 의견이 우세하지만 정치권 내부에서는 찬반 논의가 이어지고 있다. 독일 매체 슈피겔 등에 따르면 중도 보수 성향의 집권 여당 기독민주당(CDU)·기독사회당(CSU) 연합의 옌스 슈판 원내대표는 15일(현지 시각) 당내 혁신회의를 마치면서 “90억유로에서","date":"2026-04-16T13:49:09.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GQZWGNLGHE4DCZRYMVSWEYTDGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘·레바논 정상 접촉 무산됐나…“레바논 대통령이 거부”","partialText":"도널드 트럼프 미국 대통령이 예고했던 이스라엘과 레바논 정상 간 직접 대화가 사실상 무산된 것으로 전해졌다. 조셉 아운 레바논 대통령은 16일(현지 시각) 마코 루비오 미 국무장관과 통화했다고 밝혔지만 베냐민 네타냐후 이스라엘 총리와 접촉 여부를 언급하지 않았다. 레바논 언론 LBCI도 아운 대통령이 루비오 장관에게 네타냐후 이스라엘 총리와 전화 회담을 하","date":"2026-04-16T13:17:41.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/MMZTMZRZGNSGIYRRGMZDMN3BGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"IMF “아시아, 중동전쟁 영향으로 경제성장 둔화 전망”","partialText":"국제통화기금(IMF)은 미국·이스라엘과 이란의 전쟁이 가져온 에너지 공급 충격에 아시아·태평양 경제권이 상대적으로 더 노출됐다고 16일(현지 시각) 발표했다. 크리슈나 스리니바산 IMF 아시아·태평양 국장은 이날 워싱턴 DC에서 개최한 권역별 경제전망 브리핑에서 “중동 전쟁의 맥락에서, 석유와 가스 가격의 급격한 상승이 주는 충격이 얼마나 지속될지 불확실성","date":"2026-04-16T12:57:09.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GJTDSMZUGYZDKNBXGQ3GGMDGMQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美국방 “이란 합의 않으면 전투작전 재개 준비돼 있어”","partialText":"피트 헤그세스 미국 국방부(전쟁부) 장관은 16일(현지 시각) 이란에 대해 “잘못된 선택을 하고 합의를 하지 않으면 우리 군은 전투작전을 재개할 최상의 태세를 갖추고 있다”고 밝혔다. 헤그세스 장관은 이날 미 워싱턴DC 인근 국방부 청사에서 열린 대(對)이란 군사작전 관련 언론 브리핑에서 이같이 말한 뒤 “새로운 이란 정권이 현명한 선택을 하기를 바란다”고","date":"2026-04-16T12:44:51.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/HA3GCMZUGE4TOYZRMQ4TIMLEGU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"레이더 비웃는 하늘의 암살자, 이란 보란듯 모습 드러냈다","partialText":"","date":"2026-04-16T02:28:25.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/IL2AONAZOFFN5LRIAUGE5DRJVU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"총격범 맨몸으로 덮친 美고교 교장… 제2의 컬럼바인 참사 막았다","partialText":"","date":"2026-04-16T06:15:06.000Z","url":"https://www.chosun.com/international/topic/2026/04/16/Y7EZMTM34FGWVDCJ2L2TDDVYTA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[줌인] 트럼프 ‘초대형 개선문’ 설립 프로젝트, 반대 부딪힌 이유는","partialText":"도널드 트럼프 미국 대통령이 워싱턴 DC에 파리 개선문을 능가하는 초대형 개선문 건설을 추진하면서 법적 정당성을 둘러싼 논란이 확산되고 있다. 15일(현지 시각) 캐럴라인 레빗 백악관 대변인은 브리핑에서 “16일 미국 독립 선언 250주년을 기념하는 개선문(Triumphal Arch) 건설 계획이 공개될 것”이라 발표했다.  레빗 대변인에 따르면 이 건축물","date":"2026-04-16T07:23:20.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GVSGGZBUMUZTCN3DGI2WEOBWGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"파월 임기 종료 D-30인데… 후임 연준 의장 인준 ‘난항’","partialText":"다음 달 15일(현지시간) 미국 중앙은행인 연방준비제도(연준)의 제롬 파월 의장 임기가 만료되는 가운데, 도널드 트럼프 대통령이 후임으로 지명한 케빈 워시 전 연준 이사의 인준이 여전히 지연되고 있다.  15일 월스트리트저널(WSJ)은 ‘트럼프 대통령이 지명한 연준 의장 후보가 전례 없는 교착 상태에 빠졌다’는 제목의 기사에서 “워시 후보자의 인준 청문회가","date":"2026-04-16T06:58:01.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GY4DKNBWGYYDSZLBMVSTCNJUHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"조정원 WT 총재, 우즈베키스탄 최고 국가 훈장 수훈","partialText":"","date":"2026-04-16T05:46:04.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/ZAPKH3EWN5GHFL7CFLSFEO3EM4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘·레바논 휴전 합의할까... 트럼프 “양국 16일 정상회담”","partialText":"","date":"2026-04-16T04:39:32.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/W2B4ELTLSZGNPPSGYDZUWR2DQM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“한국 어딜가나 필리핀 참전 이야기… 6·25로 맺은 동맹은 여전히 끈끈”","partialText":"","date":"2026-04-15T15:43:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/TFRUXU4JVJBHZK5MLRGU63L754/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[Why] “값 떨어져도 더 캔다”… 앙골라, 다이아 생산 늘리는 이유","partialText":"글로벌 다이아몬드 가격이 하락세를 이어가는 가운데, 아프리카 최대 생산국 앙골라가 오히려 생산량 확대에 나섰다. 가격 하락을 물량으로 상쇄하겠다는 전략인데, 공급 과잉과 수요 둔화 속에서도 ‘증산 카드’를 꺼내 든 배경에 관심이 쏠린다.  15일(현지 시각) 블룸버그에 따르면 앙골라 정부는 올해 다이아몬드 생산 목표치를 전년보다 약 7% 늘린 1620만 캐","date":"2026-04-16T05:26:15.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/HBSTGNJVMI4DQOJWGU3GEN3BGA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호르무즈 나왔다던 中 선박... 美해군 봉쇄 끝내 못 뚫었다","partialText":"","date":"2026-04-15T20:18:03.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/FUZL725HTRCSXJBZADCD3XEARE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “이스라엘·레바논 정상 16일 회담…대화 나눈 지 34년 만”","partialText":"이스라엘과 레바논 정상이 오는 16일(현지 시각) 회담할 예정이라고 도널드 트럼프 미국 대통령이 밝혔다.  15일 트럼프 대통령은 트루스소셜을 통해 “이스라엘과 레바논 양국 정상이 대화를 나눈 지 34년이 흘렀다”며 “내일 양국의 회담이 열릴 것”이라고 전했다. 그러면서 이번 회담을 두고 “이스라엘과 레바논 사이 약간의 숨통이 트일 공간을 마련해주려는 것”","date":"2026-04-16T04:51:47.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/GQYWKNLCMY3DGZTGHBQTKY3CME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"사라진 3500억원 美드론, 호르무즈 인근서 추락 확인","partialText":"","date":"2026-04-16T00:06:11.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/EE2EX26AFZCH5M2NKHXQTSL5JY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"정찰은 드론, 돌격은 로봇이... 우크라 ‘보병의 종말’ 보여줬다","partialText":"","date":"2026-04-15T06:45:29.000Z","url":"https://www.chosun.com/international/international_general/2026/04/15/BPLPSBFR4RG6BNVDEYFFKVN2V4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 호르무즈 역봉쇄에 수출길 막힌 이란…‘2주내 감산’ 위기에 협상 진전되나","partialText":"미국의 호르무즈 해협 역봉쇄로 이란의 원유 수출이 막히면서 2주 내 감산이 불가피할 것이란 전망이 나왔다. 도널드 트럼프 미 대통령의 역봉쇄 조치가 이란을 협상 테이블로 불러내는 데 주효하게 작용한 것으로 풀이된다.  15일(현지 시각) 미 폭스뉴스는 싱크탱크 민주주의 수호 재단(FDD) 발표 연구를 인용, 이번 역봉쇄 조치가 이란에 하루 4억3500만달러","date":"2026-04-16T03:08:20.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/G5QTEMRTMQZDEMLCGFTGCMJWMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"번지수 잘못 짚은 ‘인권 외교’… 이스라엘의 트라우마를 건드리다","partialText":"","date":"2026-04-15T18:00:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/YN3BWSQPR5FRZDCRHRQAFPAMIU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"中 1분기 GDP 성장률 5.0%…전망치 상회","partialText":"중국 경제가 올해 1분기 5.0%의 성장률을 기록, 시장 전망을 웃도는 결과치를 내놨다. 16일 중국 국가통계국 발표에 따르면, 올해 1분기 중국 국내총생산(GDP)은 33조4193억위안(약 7226조원)으로 전년 동기 대비 5.0% 증가했다. 앞서 로이터와 블룸버그 통신은 4.8%의 전문가 전망치를 제시한 바 있다. 중국 분기별 경제 성장률은 지난해 1분","date":"2026-04-16T02:34:15.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/HFQWGYLEHBSWEMBSGEZTKYZXMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 “전쟁 곧 끝나” 이란 “홍해 막을수도”… 협상 신경전","partialText":"","date":"2026-04-15T15:55:00.000Z","url":"https://www.chosun.com/international/us/2026/04/16/SCKBJQHTXZHW7BFGDNSVV56XPY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘예수 행세 논란’ 트럼프, 이번엔 예수에 안겼다…“광신도들은 싫어할 듯”","partialText":"","date":"2026-04-15T23:48:24.000Z","url":"https://www.chosun.com/international/international_general/2026/04/16/5OQISGV2G5B6DMYW7BB3YRQLNY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“농경민족이라 폐쇄적? 일본 어민에겐 ‘해양민족’의 피가 흐른다”","partialText":"","date":"2026-04-05T18:00:00.000Z","url":"https://www.chosun.com/international/japan/2026/04/06/TSXCCPRNC5A3VLIGRJML5657AY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboun
00.000Z","url":"https://www.chosun.com/international/china/2025/10/30/CHNZFBLOD5FEZA7QQNGEAZ45MI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[Who] 美 서부 진보진영의 라이징스타로 떠오른 니티야 라만 LA시장 후보","partialText":"미국 캘리포니아주 로스앤젤레스(LA)에서 차기 시장 자리를 두고 격전이 펼쳐질 것으로 보인다. 서부 진보 진영의 라이징 스타로 떠오른 니티야 라만 LA4 지구 시의원이 전격 출마를 선언하며 재선이 유력했던 캐런 배스 현 시장에 세대 교체 도전장을 내밀었기 때문이다.  미 뉴욕타임스(NYT)에 따르면, 라만은 7일(현지 시각) 후보 등록 마감은 몇 시간 앞두","date":"2026-02-10T06:11:39.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/G5SWCMTEGJSDOYRTGUZDCMBVMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"중국 ‘생산 갑질’에 전세계 자동차업계가 휘청","partialText":"","date":"2025-12-10T18:00:00.000Z","url":"https://www.chosun.com/international/china/2025/12/11/BYARXQRSAFEJDE5B3F6RFALBBI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"미국과 무역전쟁 8년째... 망하기는커녕 더 강력해진 중국의 ‘비결’은","partialText":"","date":"2025-12-24T18:00:00.000Z","url":"https://www.chosun.com/economy/int_economy/2025/12/25/ZNMRGIT3INCRVFNCXMIBXX3YHQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"무역 흑자만 1조 달러...중국은 무역전쟁에서 이기고 있다","partialText":"","date":"2026-01-07T18:00:00.000Z","url":"https://www.chosun.com/economy/int_economy/2026/01/08/5CSBKKPANFAVZHWBXPDKNC2JPA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이 대통령은 왜 상하이 ‘천지닝’을 만났나...‘잠룡 검증대’의 비밀","partialText":"","date":"2026-01-21T18:00:00.000Z","url":"https://www.chosun.com/international/china/2026/01/22/G2ZTRRO3OZA7NCDXVEGCHGIEIU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“라푸푸 잡는다”… 이젠 자국 상품 ‘짝퉁’과 전쟁하는 중국","partialText":"전 세계 위조품의 온상이던 중국이 최근 자국 브랜드를 지키기 위해 짝퉁과의 전쟁을 벌이고 있다. 자국 브랜드들 역시 위조품 피해를 입기 시작하면서, 중국이 기술 도용과 짝퉁 제조 국가라는 이미지를 벗어나려는 모양새다.  9일(현지 시각) 영국 주간지 이코노미스트는 “최근 몇 년 새 중국의 허술한 상표와 특허 보호 시스템은 이제 중국 기업들 자신에게도 점점","date":"2026-02-10T05:55:59.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/ME3DEMJXMIZTKZJZMM3TIZJSMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"막강 권력 다카이치, 다음은 ‘강한 일본’","partialText":"","date":"2026-02-09T15:55:00.000Z","url":"https://www.chosun.com/international/japan/2026/02/10/R4SK7C7ATRCH7KH24WAHQ26NOY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"구직자가 돈 내는 채용시장… 美서 ‘역채용’ 확산","partialText":"미국에서 사무직 구직자들이 일자리를 얻기 위해 헤드헌터에게 비용을 지불하는 이른바 ‘역채용(리버스 리크루팅)’이 확산되고 있다. 기업이 채용 담당자에게 수수료를 지급하던 전통적인 채용 구조가 뒤집히며 구직자가 비용을 부담하는 새로운 시장이 형성되고 있다는 분석이 나온다.  8일(현지 시각) 월스트리트저널(WSJ)에 따르면 이 같은 변화는 노동시장 상황 악화","date":"2026-02-10T05:01:38.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/HE3WIZLGMUZGGMJZGZRWEMJXMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“中, 춘제 앞두고 700兆 유동성 공백”… 대규모 자금 공급","partialText":"중국이 춘제(春节·중국 설) 연휴를 앞두고 금융권의 유동성 부족을 막기 위해 대규모 자금 투입에 나섰다. 명절 기간 가계 현금 수요 급증과 정부의 국채 발행 가속화, 기업의 위안화 수요 증가가 동시에 나타나면서 유동성 우려가 커진 데 따른 선제적 조치다.  9일(현지시각) 블룸버그통신에 따르면 중국 중앙은행인 인민은행은 최근 14일 만기 역환매조건부채권(역","date":"2026-02-10T05:00:36.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/ME3TMNJXGEYDIZDCMY3GIZBZME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘미사일 2000개’에 트럼프도 멈칫?… WSJ “이란, 美방어망 뚫는 법 터득”","partialText":"","date":"2026-02-10T03:35:56.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/HUOH2S3QPZHE3JUNLHPNJDLEEI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"배드 버니 수퍼볼 무대 대항 공연 펼친 원조 MAGA 키드 록","partialText":"","date":"2026-02-09T19:05:07.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/RQCNOV76OZEJJK4VOA4ZQIGGYA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"폴란드 9세 소년, 2.76초 만에 큐브 맞춰…‘3초 벽’ 깼다","partialText":"폴란드의 9세 어린이가 표준 큐브로 불리는 3×3×3 루빅스 큐브를 2.76초 만에 완성하며 세계 신기록을 세웠다. 현지 매체 TVP와 세계큐브협회(WCA)에 따르면 테오도르 자이데르(9)는 7~8일(현지 시각) 폴란드 그단스크의 제48초등학교에서 열린 스피드 큐빙 대회에서 3×3×3 큐브를 2.76초에 맞췄다. 종전 기록은 중국의 겅쉬안이 지난해 세운","date":"2026-02-10T04:24:05.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/MI4DQYJVGM2TEZJWGJSDCODEGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“2023년 삼성 공장서 기준치 초과 발암물질” 경영진 도청한 헝가리 사찰 보고서 논란","partialText":"","date":"2026-02-09T22:02:51.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/HO3HGNFDCBDMTFYOQNUBQNUGCU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“다카이치가 스케이트를”… 日 총선에 ‘K-개표 방송’ 수출?","partialText":"","date":"2026-02-10T01:30:11.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/LRTGS7Q6SZC4PN3CLIDT7SCZNY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“비행기 연료도 없다”… 美 제재에 쿠바 관광 산업도 ‘타격’","partialText":"도널드 트럼프 미 행정부가 쿠바에 대한 석유 공급을 차단하면서 쿠바 관광 산업이 직격탄을 맞았다. 관광 산업은 쿠바 경제의 핵심 축인 만큼, 이미 불안정한 쿠바 경제가 한층 더 큰 타격을 입을 것으로 보인다.  9일(현지 시각) 뉴욕타임스(NYT)에 따르면 캐나다 항공사 에어캐나다는 이날부터 쿠바 4개 도시를 오가며 주 16회 운항하던 항공편을 전면 중단한","date":"2026-02-10T01:46:44.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/MUYWKMBVGJRWEODDGFSTGODGHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘스키 여제’ 린지 본, “동화 결말 아니지만…나는 뛰어올랐다”","partialText":"","date":"2026-02-10T01:44:05.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/GZTQRSCX2FEEZHTAYLVFYQ7YFM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"엡스타인 옛 연인, 美 의회 증언 거부…“사면 받으면 진술할 것”","partialText":"","date":"2026-02-09T22:39:49.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/VKWFVJQVAVBHLFBFYKDHXPCFWU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"71세 ‘액션 전설’ 성룡, ADHD 고백 “끊임없이 채찍질 해왔다”","partialText":"","date":"2026-02-09T22:26:47.000Z","url":"https://www.chosun.com/international/international_general/2026/02/10/KLUJZDZUNFB3BAHEYFLYIGLHIU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"전기요금 한국보다 3.3배 비싼 탈원전 이탈리아... 뒤늦게 원전 건설 추진중 [손진석의 머니워치]","partialText":"","date":"2026-02-09T10:03:07.000Z","url":"https://www.chosun.com/international/europe/2026/02/09/OQHVUO6BNVDADPTL5AUAKXU7N4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 측근 의원, ‘쿠팡 청문회’에 “美기업 대우 공정하고 차별 없어야”","partialText":"","date":"2026-02-09T22:03:36.000Z","url":"https://www.chosun.com/international/us/2026/02/10/G3W2P6VGUZE63J2ZUW6NDY6ELA/"},{"spec":{"publisher":{"id":"c
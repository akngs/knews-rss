hosun.com/international/international_general/2026/04/23/MORUL74C5JBZ3ILF62TUFZHQSQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"협상은 안 하고… 美·이란, 선박 나포 영상 공개하며 기싸움","partialText":"","date":"2026-04-23T15:57:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/NNAKMXZ5UJFJTIIRR4DTI243UQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란 “호르무즈는 인터넷 동맥”… 석유 이어 해저 케이블도 인질로","partialText":"","date":"2026-04-23T15:54:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/EQHC6CC3HZCLHJ77LB65ICAMUI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 매카시 前하원의장 “韓정부 좌파로 기울어 잘못된 길 가고 있다”","partialText":"","date":"2026-04-23T15:53:00.000Z","url":"https://www.chosun.com/international/us/2026/04/24/ZSDOTO6FCRFJJFTYI6HP5RRRFY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"우크라戰·대만 위협 명분 삼아… 패전국 獨·日, 나란히 재무장 속도","partialText":"","date":"2026-04-23T15:51:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/PALD2VLWOJGQFIQXU6KLTEST7Y/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"중동 분쟁 장기화 우려…국제 유가 3%↑","partialText":"","date":"2026-04-23T20:18:27.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/LRJUDUVHXRBM5OV5M3LNMAIW44/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 백악관 “中이 미국 AI 기술 훔친 증거 확보”","partialText":"미국 도널드 트럼프 행정부는 중국 기업들이 미국의 인공지능(AI) 기술을 훔치고 있다고 23일(현지 시각) 비난했다.  마이클 크라치오스 백악관 과학기술정책실장은 이날 엑스(X·옛 트위터)를 통해 “미국은 주로 중국을 비롯해 외국 업체들이 미국의 AI를 훔치기 위해 대규모 증류(distillation) 캠페인을 벌이고 있다는 증거를 확보했다”며 “우리는 미","date":"2026-04-23T23:30:04.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/MYZDEYLFGRRDGYRWGM3DQYJVGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “이스라엘-레바논 휴전 3주 연장될 것”","partialText":"도널드 트럼프 미 대통령은 이스라엘과 레바논이 3주간 휴전을 연장하기로 했다고 23일(현지 시각) 밝혔다.  트럼프 대통령은 이날 백악관 집무실에서 이스라엘과 레바논 특사들을 만난 후 소셜미디어 트루스소셜을 통해 “회담은 매우 성공적이었다”면서 이 같이 밝혔다. 이스라엘과 레바논의 휴전은 오는 26일 끝날 예정이었다. 이번 회담은 지난 14일 워싱턴DC에서","date":"2026-04-23T22:11:44.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/GZSDOODCGFTGCMRVGA4TKY3EGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"뉴욕증시, 이란 전쟁 불확실성 심화에 하락 마감","partialText":"미국과 이란의 추가 종전 협상이 불발되면서 불확실성이 커지자 뉴욕증시 3대 지수가 일제히 하락 마감했다.  23일(미 동부시각) 뉴욕증시에서 다우존스30 산업평균지수는 전장보다 179.71포인트(0.36%) 내린 4만9310.32에 거래를 마쳤다. 스탠더드앤드푸어스(S&P) 500 지수는 전장보다 29.50포인트(0.41%) 내린 7108.40에, 기술주","date":"2026-04-23T21:42:10.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/GFTGKMBXHEZDAOBQMUZTENJRMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란 지도부, 내부 결속 촉구… “심리전 경계해야”","partialText":"미국과 이란의 종전협상이 안갯속에 빠진 가운데 이란 지도부가 내부 결속을 촉구하는 메시지를 잇따라 내놓았다.  23일(현지 시각) 이란 국영 IRNA 통신에 따르면 모즈타바 하메네이 이란 최고지도자는 “이란 국민 사이에 형성된 놀라운 단결로 인해 적 내부에 균열이 생겼다”면서 “이란의 응집력은 더욱 강력하고 강철처럼 견고해졌다. 이런 과정을 통해 결국 적들","date":"2026-04-23T21:24:19.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/GA4DKYZVGVRGKYRYMNSTQYRVGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘 언론 “이란 종전 협상단 대표 사임”","partialText":"","date":"2026-04-23T18:22:22.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/3XUB3VWCO5A77CCKIC4XNYGVLA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “이란에 핵무기 사용 안 할 것… 누구도 안돼”","partialText":"도널드 트럼프 미국 대통령은 미국과 전쟁 중인 이란에 핵무기를 사용하지 않을 것이라고 23일(현지 시각) 밝혔다.  로이터통신 등에 따르면 트럼프 대통령은 이날 백악관에서 열린 ‘의료비 절감’ 관련 행사에서 ‘이란에 핵무기를 사용할 의향이 있냐’는 질문에 “아니다”라고 답했다. 이어 “핵무기 없이도 재래식 방식만으로도 이미 그들을 완전히 초토화했는데 왜 핵","date":"2026-04-23T21:15:23.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/MMYGMNZRMZTDQNTEMY2DGMRSMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘 국방부 장관 “이란과 전쟁 재개 준비 완료… 美 승인 대기 중”","partialText":"이스라엘 카츠 이스라엘 국방부 장관이 이란과의 전쟁을 재개할 준비를 마쳤으며, 미국의 승인을 대기 중이라고 밝혔다. 카츠 장관은 23일(현지 시간) 군 수뇌부와 함께 한 안보 전황 평가 회의에서 “이스라엘은 이란과의 전쟁을 재개할 준비가 돼 있다. 이스라엘군은 방어와 공격 모두에서 대비를 마쳤고, 타격 목표 설정도 완료했다”고 언급했다.  그는 “이스라엘","date":"2026-04-23T16:52:29.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/MU4TENZZGQZTEOBVG44DGNLCGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"쿠팡, 유출 사태 이후 美 정·관계 로비에 백악관·부통령도 포함","partialText":"한국 전자상거래 1위 기업 쿠팡이 대규모 정보 유출 사태 이후 백악관을 포함한 미국 정·관계를 상대로 로비를 벌인 것으로 드러났다. 23일(현지 시간) 미국 연방 상원의 로비 공개법(LDA·Lobbying Disclosure Act) 보고서에 따르면, 쿠팡의 미국 워싱턴 시애틀에 기반을 둔 모회사 쿠팡Inc는 올해 1분기 로비 자금으로 109만달러(약 16","date":"2026-04-23T16:17:10.000Z","url":"https://www.chosun.com/international/international_general/2026/04/24/MMYTCNDGGBSWIOJSGBSTGNRVGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 육참총장 이어 해군장관도 사임… ‘트럼프에 충성 경쟁’서 밀려났나","partialText":"","date":"2026-04-23T15:45:00.000Z","url":"https://www.chosun.com/international/us/2026/04/24/LXPC6AOSFBCUDKYLTDMBWKAVSA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “기뢰 설치하는 모든 선박 격침” 명령","partialText":"","date":"2026-04-23T13:41:21.000Z","url":"https://www.chosun.com/international/international_general/2026/04/23/N3KGXIHWJZB6JKC3CNBAADFNWY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프 “호르무즈 해협에 기뢰 부설하는 모든 선박 격침” 경고","partialText":"도널드 트럼프 미국 대통령은 23일(현지 시각) 호르무즈 해협에 기뢰를 설치하는 모든 선박을 격침하겠다고 경고했다. 트럼프 대통령은 이날 소셜미디어 트루스소셜에서 “나는 미 해군에 호르무즈 해협 수역에 기뢰를 설치하는 모든 선박에 대해 그것이 아무리 소형 선박이라 할지라도 사격해 격침(shoot and kill)하라고 명령했다”며 “주저해서는 안 된다”고","date":"2026-04-23T13:33:58.000Z","url":"https://www.chosun.com/international/international_general/2026/04/23/GNSGGZBWGVQTKYZYGMYDMYZRMQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"열정적으로 지휘하다… ‘최소 17억’ 바이올린, 바닥에 ‘우당탕’","partialText":"","date":"2026-04-23T07:39:25.000Z","url":"https://www.chosun.com/international/topic/2026/04/23/XQ43SI7TWBAOBCYDZQCNG7YDUI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란과 전쟁 중인데... 美 해군장관 돌연 사임","partialText":"","date":"2026-04-23T00:31:02.000Z","url":"https://www.chosun.com/international/international_general/2026/04/23/5LQ74XY5IZFFNOB7WT7DIV7STY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"복면 쓴 채 사다리 타고 위협... 이란, 선박 나포 대놓고 홍보","partialText":"","date":"2026-04-23T04:54:03.000Z","url":"https://www.chosun.com/international/international_general/2026/04/23/KIKAO4X27FGBXOH5ILWQMMW2WA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","cate
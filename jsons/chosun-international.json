.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프의 잠 못 이루는 밤… 직접 전화 받는 대통령, ‘특종’이 쏟아진다","partialText":"","date":"2026-03-16T20:00:00.000Z","url":"https://www.chosun.com/international/us/2026/03/17/CDHJKUTKU5COVCH2XFJBEHCQMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"1980년대에도 美 군함·유조선 피격…지금 호르무즈는 더 위험해졌다","partialText":"","date":"2026-03-16T19:04:31.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/2RWYV25DV5E4XLN7NKZZLK2GA4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프, 韓·中·日 콕 집어 “호르무즈 호위 지원해야”","partialText":"","date":"2026-03-16T16:41:16.000Z","url":"https://www.chosun.com/international/us/2026/03/17/QF3BXVYK6BCUXCMFVJZTQ6FCP4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"2주 앞둔 미중 정상회담… 美재무장관 “연기될 수도”","partialText":"","date":"2026-03-16T15:59:15.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/CMMYW5LYRBDT5EZJ4TEABYKHJQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"석유 ETF로 몰리는 글로벌 개미들… 개인 자금 유입 ‘역대 최고치 경신’","partialText":"중동 내 군사적 긴장 고조로 국제 유가 변동성이 극심해지면서 석유 관련 금융 상품에 개인 투자자 자금이 몰리고 있다. 기존 주식과 가상자산에 쏠렸던 시선이 원유 시장으로 급격히 옮겨 붙으며, 단순 자산 배분을 넘어선 투기 수요가 가격 널뛰기를 부추기는 모양새다. 과거 게임스톱 밈 주식 사태나 올해 초 금(金)과 은(銀) 시장에서 목격됐던 매수 광풍과 흡사하","date":"2026-03-17T05:05:36.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GJQWIMJUGE2WGZBXMQ2WIZLCGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란 문턱에서 벌어지는 또 다른 전쟁… 아프간·파키스탄 유혈 충돌 격화","partialText":"이란을 둘러싼 중동 긴장이 고조되는 가운데, 그 접경지에서 또 다른 무력 충돌이 격화하고 있다. 아프가니스탄과 파키스탄이 국경 지역에서 공습과 포격을 주고받으며 민간인 피해가 빠르게 늘고 있다.  지난달 26일(현지 시각)부터 시작된 파키스탄의 대대적인 공습으로 아프가니스탄 접경 지역은 아비규환의 현장이 됐다. 유엔(UN)의 보고에 따르면 파키스탄군은 군사","date":"2026-03-17T05:02:43.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/HAZDENJTG43TQZJZGRSDEMJYMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“日정부, 호르무즈 해협에 자위대 파견 검토”","partialText":"도널드 트럼프 미국 대통령이 한국과 일본 등 동맹국에 호르무즈 해협으로 함정 파견을 요구한 가운데, 일본 정부가 자위대 파견 가능성을 검토하고 있다고 아사히신문이 17일 보도했다.  아사히신문에 따르면 일본 정부 관계자는 자위대 파견 가능성에 대해 집중적으로 검토하고 있다고 밝혔다. 앞서 다카이치 사나에 일본 총리는 전날 “일본이 독자적으로 법적 틀 안에서","date":"2026-03-17T04:47:12.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/MY2DEM3CHFTDGMTGMRRGEZLEHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美, 신세계 ‘AI 팩토리’ 구축에 “이게 바로 동맹 기반 AI 주권 모습”","partialText":"","date":"2026-03-17T02:35:54.000Z","url":"https://www.chosun.com/international/us/2026/03/17/NESMA5UVVBGU7NZ3LBFMF2EIYE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"넷플릭스 안 되는데 평점 7000개… 중국, ‘월간남친’ 도둑 시청 논란","partialText":"넷플릭스의 새로운 오리지널 콘텐츠인 ‘월간남친’이 세계적인 인기를 얻고 있는 가운데 중국에서 불법 시청되고 있다는 비판이 제기됐다. 서경덕 성신여대 교수는 17일 자신의 페이스북 계정을 통해 “월간남친이 해외에서도 열풍을 일으키자 일부 중국 누리꾼이 훔쳐보고 있다”고 주장했다. 중국의 소셜미디어 플랫폼 더우반에서는 월간남친이 평점 7.5점(10점 만점)을","date":"2026-03-17T02:48:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GVTDIOLCME2WCYJZMU4DSZBTGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"미국서 청천백일기 내걸고… 美·日·대만 3도시, 반도체 동맹","partialText":"","date":"2026-03-16T15:45:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/ISADC5M2ONBJBOWV2WMDUHSU4E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"미·중, 파리서 6차 무역협상…트럼프·시진핑 회담 안갯속에도 대화 지속","partialText":"","date":"2026-03-16T15:15:40.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/E3QOUH6YT5D5DIGCE4UCHQVWLQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"모즈타바 극적 생존… “건물 밖 나섰다가 가까스로 폭격 피했다”","partialText":"이란의 새 최고 지도자 모즈타바 하메네이(56)가 지난달 28일 미국과 이스라엘의 공습 직전 잠시 건물 밖으로 나갔다가 가까스로 목숨을 건진 것으로 전해졌다.  16일(현지 시각) 영국 일간 텔레그래프는 모즈타바가 아버지인 고(故) 아야톨라 알리 하메네이와 함께 건물 안에 있었지만, 무언가를 하러 정원으로 나간 사이 공격이 발생한 것으로 보인다고 보도했다.","date":"2026-03-17T01:39:55.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/MEYGMZBXHE2GEMRTMQ3DAMRWHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"英윌리엄 왕세자, 다이애나빈 사진 공개…“매일 어머니 기억해”","partialText":"","date":"2026-03-16T14:40:05.000Z","url":"https://www.chosun.com/international/international_general/2026/03/16/F7SUJVBSA5ENBIUOTEX6A2OKHU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호주·독일 “호르무즈 군함 파견, 참여 안 할 것”","partialText":"","date":"2026-03-16T12:40:06.000Z","url":"https://www.chosun.com/international/international_general/2026/03/16/HGZ3VIYJQ5GMRP5OMNURTGJYRE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호르무즈 해협 긴장에 UAE 어업 마비… 생선값 35% ‘껑충’","partialText":"이란을 둘러싼 군사적 긴장이 이어지는 가운데, 아랍에미리트(UAE)의 어민들이 전쟁의 ‘부수적 피해자’가 됐다고 프랑스 일간 르 몽드가 보도했다. 호르무즈 해협이 사실상 봉쇄되면서 UAE 어업 생태계가 마비됐기 때문이다.  르 몽드에 따르면 UAE 당국이 안전을 이유로 전면적인 출항 금지령을 내리면서 수백 척의 어선들이 조업을 중단한 채 항구에 묶여 있다.","date":"2026-03-17T01:19:15.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GAYDEMZSHA4DIN3EMU2GEYRWGU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"다음 타깃은 쿠바?… 트럼프 행정부, 디아스카넬 대통령 축출 추진","partialText":"베네수엘라의 니콜라스 마두로 정권과 이란의 아야톨라 알리 하메네이 정권을 무너뜨린 도널드 트럼프 미 행정부가 사실상 다음 타깃으로 쿠바를 지목했다. 트럼프 행정부가 미겔 디아스카넬 쿠바 대통령에게 사임을 압박하고 있다는 것이다.  16일(현지 시각) 뉴욕타임스(NYT)는 익명의 소식통 4명을 인용해 “트럼프 행정부가 디아스카넬 대통령을 권좌에서 물러나게 하","date":"2026-03-17T01:15:43.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GM3WGMDCGBRTEMZXHE4TMMJUMM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"전투기 거두고 반미 발언도 ‘쏙’… 트럼프 방중에 몸 낮추는 중국","partialText":"","date":"2026-03-16T18:00:00.000Z","url":"https://www.chosun.com/international/china/2026/03/17/P3OFPVBB2FFABJU22T6GCAIIK4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"곰 습격 사건 보도하던 美 기자 뒤에 흑곰 등장","partialText":"미국에서 벌어진 곰 습격 사건을 현장 중계하던 기자 뒤에 실제 곰이 나타나는 일이 발생했다. 지난 15일(현지 시각) 미국 캘리포니아주 지역 방송 KTLA는 몬로비아의 한 촬영 현장에서 곰이 출몰했다고 보도했다. 이날 현장에서 중계하던 에린 마이어스 기자는 해당 지역에서 벌어진 곰 습격 사건에 대해 보도하고 있었다. 마이어스는 사건이 발생한 주택가 도보를","date":"2026-03-17T01:02:03.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GQ2GEZBWMU2TKN3FMU2WEZTCHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"日 길거리 수상한 흰 가루에 ‘발칵’… 알고 보니 ‘러닝용 밀가루’","partialText":"일본에서 한 남성이 길거리에 흰 가루를 뿌렸다는 신고에 경찰과 소방대가 긴급 출동하는 소동이 일어났다. 17일 요미우리신문 보도에 따르면 일본 효고현 아마가사키 경찰에는 지난 9일 오후 7시 40분쯤 한 지하철역 앞에서 “수상한 남성이 길거리에 흰 가루를 뿌리고 있다”는 신고가 들어왔다. 신고 접수 후 경찰 10여 명과 지원 요청을 받은 소방대원들이 현장에","date":"2026-03-17T00:44:34.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GU4TGMDCMVRWMN3EGUYDKZBXMY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"쿠바, 전 지역 정전 사태… 트럼프 “쿠바 접수 가능”","partialText":"도널드 트럼프 미 행정부의 제재로 에너지 위기를 겪고 있는 쿠바의 전 지역에서 정전이 발생했다.  16일(현지 시각) 쿠바 에너지광산부는 소셜미디어(SNS) 엑스(X·구트위터)를 통해 국가 전력 시스템의 “완전한 단절”이 발생했다며, 현재 원인을 조사하고 있다고 밝혔다. 쿠바 국영전력청(UNE)도 “국가전력망의 완전한 가동 중단”에 따라 전력 시스템이 완전","date":"2026-03-17T00:31:32.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GU4DSMBVGY3DAMTGG5RDENRYMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“일본제 무기를 팔 절호의 기회”… 다카이치의 치밀한 방위산업 전략","partialText":"","date":"2026-03-16T18:00:00.000Z","url":"https://www.chosun.com/international/japan/2026/03/17/WJ4ZDMYR7BFO7OD4SQZYUVH7PM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘트럼프 측근’ 와일스 백악관 비서실장, 유방암 초기 진단","partialText":"도널드 트럼프 미 대통령의 ‘최측근’ 인사로 알려진 수지 와일스 백악관 비서실장이 초기 유방암 진단을 받았다.  트럼프 대통령은 16일(현지 시각) 소셜미디어(SNS) 트루스소셜에 와일스 비서실장이 “안타깝게도 초기 유방암 진단을 받았고, (치료를) 미루는 게 아니라 즉시 이 도전에 맞서기로 결정했다”고 밝혔다. 이어 “그녀는 환상적인 의료진을 두고 있으며","date":"2026-03-16T23:06:49.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/G5SWIMDGMY4TGODFMZSWCYTFG4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프, 주한미군 숫자 거론하며 韓 호르무즈 파병 압박","partialText":"도널드 트럼프 미국 대통령은 16일(현지 시각) 한국 등을 다시 거론하며 호르무즈 해협을 통과하는 선박 호위 작전에 동참할 것을 압박했다.  트럼프 대통령은 이날 백악관 집무실에서 기자들에게 “우리는 일본에 4만5000명의 병력을 두고 있다는 점을 기억해야 한다. 한국에도 4만5000명의 병력을 두고 있고, 독일에도 4만5000~5만명의 병력이 있다”고 주","date":"2026-03-16T22:53:57.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/MMZTMYJTMIZTOZDBGJTGIMDGGY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美 FCC “이란전 비판 방송, 면허 취소할 수도”","partialText":"","date":"2026-03-16T15:45:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/K4K2YGJYZNAJ3DU7FK6G2E6ZTM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"기뢰·모기 함대·미사일 ‘독침 3종 세트’… 첨단 이지스함도 멈칫한다","partialText":"","date":"2026-03-16T15:51:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/ROU53PVBIVECTG5DPT76QKKHHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이스라엘 아이언돔 빠르게 소진… “전술핵 사용 우려”","partialText":"","date":"2026-03-16T15:51:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/2ZRP3FQJJZEQDD7NWNUR6LXLOM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"갈라치기 나선 이란 “美·이스라엘은 빼고 호르무즈 협상 환영”","partialText":"","date":"2026-03-16T15:52:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/UXEOZCZ22BDONBAANM5JLMNJBU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美국무 “한국, 호르무즈 안전 협력해야”","partialText":"","date":"2026-03-16T15:57:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/DWR7OEFADFBCTA2T2A3XIBUJFU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호르무즈 해협 日 자위대 파견 고민... 다카이치, 결단하나","partialText":"","date":"2026-03-15T09:16:42.000Z","url":"https://www.chosun.com/international/international_general/2026/03/15/HGUEJDC2XFBL5FIZPHPCZN4C4E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"호르무즈 개방 기대감에 뉴욕증시 상승 마감","partialText":"핵심 원유 수송로인 호르무즈 해협 개방 기대감이 커지면서 뉴욕증시 3대 지수가 동반 상승했다.  16일(미 동부시각) 뉴욕증권거래소(NYSE)에서 다우존스30산업평균지수는 전장보다 387.94포인트(0.83%) 오른 4만6946.41에 거래를 마감했다. 스탠더드앤드푸어스(S&P) 500지수는 전장보다 67.19포인트(1.01%) 상승한 6699.38, 나스","date":"2026-03-16T21:21:47.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/MVQWKZDFG43DIMJQMEYDOOJVHE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프, 미중정상회담 “약 한 달 연기 요청했다”","partialText":"도널드 트럼프 미국 대통령이 중국 측에 미·중 정상회담 연기를 요청했다고 밝혔다.  16일(현지 시각) AP통신에 따르면 트럼프 대통령은 이날 백악관 집무실에서 중국 측에 자신의 방문을 “한 달 정도 연기해 달라고 요청했다”고 말했다. 그는 “우리는 중국과 대화하고 있다”며 “나도 중국을 방문할 예정이지만 지금은 여기에 있어야 한다고 생각한다”고 했다. 다","date":"2026-03-16T21:07:48.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/MI3GGNTBMVSTCY3BG42TKNJXGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美, 이란전 올인에… 우크라전 종전 협상은 뒷전으로","partialText":"","date":"2026-03-16T15:45:00.000Z","url":"https://www.chosun.com/international/us/2026/03/17/EG6K7Y6ZYJCQLNWB6V56EVZ7X4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"트럼프, 韓 등에 호르무즈 지원 압박…“우리가 40년 보호\"","partialText":"도널드 트럼프 미국 대통령은 16일(현지시간) 한국·일본·중국을 언급하며 “호르무즈 해협 방어에 도움을 주길 바란다”고 했다. 트럼프 대통령은 이날 트럼프-케네디센터에서 열리는 오찬에 앞서 진행된 기자회견에서 “우리는 호르무즈 해협에서 석유의 1%도 채 얻지 못한다”며 “하지만 다른 국가는 훨씬 더 많은 양을 얻고 있다”고 말했다.  이어 “일본은 95%,","date":"2026-03-16T16:59:40.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/GNSTIZJXME2WIY3GMQYDKNZVMI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[깨알지식Q] 성소수자 ‘LGBT’는 알겠는데, ‘QIA+’는 뭐지","partialText":"","date":"2026-03-16T15:45:00.000Z","url":"https://www.chosun.com/international/international_general/2026/03/17/K7UL5377MZBYLO7DHGUJGUK3UE/"}]
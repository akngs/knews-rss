chosun.com/international/international_general/2026/04/07/2OU2GCTPTNEZ7DHFOQH747GGKM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"적진도 몇시간이면 美기지로... 특수부대의 치밀한 탐색전","partialText":"","date":"2026-04-07T02:27:51.000Z","url":"https://www.chosun.com/international/international_general/2026/04/07/YTMCWTFA2BCLDKJ4MYJB4JXSOY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘역대급 조종사 구출’ 트럼프도 못 넘는 이란 전쟁 한계 셋","partialText":"","date":"2026-04-07T01:59:14.000Z","url":"https://www.chosun.com/international/international_general/2026/04/07/2YYUSCZ6IJGFXON4M4X5LUDCD4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"공포의 석기시대 서막인가... “미군, 이란 하르그섬 군시설 공격”","partialText":"","date":"2026-04-07T11:49:15.000Z","url":"https://www.chosun.com/international/international_general/2026/04/07/WECBWEHZCFEC7FZ3KAX6BRET3E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란 상공에 침묵의 암살자처럼... B2 닮은 美 스텔스 드론","partialText":"","date":"2026-04-07T06:51:40.000Z","url":"https://www.chosun.com/international/international_general/2026/04/07/3AKFB4UUCVE4XHUVXFD7C3QOXY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"이란 “청년들, 발전소 모여라”... 트럼프 위협에 인간방패 모집","partialText":"","date":"2026-04-07T07:24:03.000Z","url":"https://www.chosun.com/international/international_general/2026/04/07/QNUGJWRDKZAFDFLVRSVJDQEXYU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“이란, ‘조건부 휴전’ 사실상 수용… 10일 美와 협상”","partialText":"도널드 트럼프 미국 대통령이 제안한 대로 이란도 2주간 휴전에 사실상 동의한 것으로 나타났다. 다만 공격 중단을 전제로 한 ‘조건부 휴전’ 성격이어서 향후 협상 결과에 따라 충돌이 재개될 가능성도 남아 있다.  7일(현지 시각) 뉴욕타임스(NYT)와 로이터통신에 따르면 이란 최고 국가안보회의는 이날 성명에서 이란이 미국, 이스라엘과의 전쟁에서 승리했으며 이","date":"2026-04-08T00:00:11.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/G5RDOYTBGJSDCNZZHA3TEZBVMU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“호르무즈 열면 2주 쉰다”… 트럼프 한마디에 유가 12% 급락","partialText":"도널드 트럼프 미국 대통령이 이란에 대한 군사 행동을 조건부로 유예하겠다고 밝히자 국제 유가가 급락했다. 중동 긴장 완화 기대가 시장에 즉각 반영된 것이다.  블룸버그에 따르면 8일 오전 8시 5분(한국 시각) 기준 5월 인도분 서부텍사스원유(WTI) 선물 가격은 전 거래일 대비 12.49% 급락한 배럴당 98.84달러를 기록했다. WTI가 장중 기준으로","date":"2026-04-07T23:36:18.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/GY2TOM3CGZQWEMJYGY4GMNLEGQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[속보] 트럼프, ‘2주 휴전’ 동의… 호르무즈 개방 조건","partialText":"도널드 트럼프 미국 대통령이 이란에 대한 군사 행동을 불과 1시간 30분 앞두고 전격 유예했다. 파키스탄의 중재 요청을 받아들여 ‘2주간 공격 중단’에 조건부로 동의한 것이다.  7일(현지 시각) 트럼프 대통령은 자신의 소셜미디어(SNS) 트루스소셜을 통해 “이란과는 완전하고(complete), 즉각적이며(immediate), 안전하게(safe) 호르무즈","date":"2026-04-07T23:12:29.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/GQ4WIYZSHA2DCOBUGZSGEMRRGI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"네타냐후 “철도·교량 타격… 이란 정권 압박 강화\"","partialText":"도널드 트럼프 미국 대통령이 제시한 협상 시한이 임박한 가운데, 베냐민 네타냐후 이스라엘 총리가 이란 정권에 대한 압박 수위를 높이고 있다고 밝혔다.  7일(현지 시각) 네타냐후 총리는 영상 메시지를 통해 “이란의 테러 정권을 점점 더 강도 높게 압박하고 있다”며 최근 군사 작전 성과를 공개했다. 네타냐후 총리는 “전날 우리는 이란의 수송기와 수십 대의 헬","date":"2026-04-07T22:36:47.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/GQ2DSNRWGYYTOYLCGVSDOMDDHA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"협상 시한 앞두고 출렁인 뉴욕증시… 혼조 마감","partialText":"도널드 트럼프 미국 대통령이 정한 협상 시한을 몇 시간 앞둔 가운데, 미국 주식 시장이 보합권에서 혼조 마감했다. 국제 유가도 큰 변동 없이 마감했다. 이날 증시와 유가는 협상 관련 소식에 민감하게 반응하며 등락을 거듭했다.  7일(현지 시각) 뉴욕증권거래소(NYSE)에서 다우존스30산업평균지수는 전 거래일보다 0.18% 내린 4만6584.46에 장을 마감","date":"2026-04-07T21:37:36.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/MQ3TGMBRMYYTEZBRGEZGEYLDGM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"협상 시한 직전… ‘2주만 더’ 파키스탄 긴급 제안","partialText":"도널드 트럼프 미국 대통령이 설정해둔 이란과의 협상 시한 종료를 불과 몇 시간 앞두고 중재국 파키스탄이 ‘2주 연장’과 휴전을 전격 제안했다. 전면 충돌 직전 막판 외교가 작동할 수 있을지 주목된다.  셰바즈 샤리프 파키스탄 총리는 7일(현지 시각) 소셜미디어(SNS) 엑스(X·옛 트위터)에 “트럼프 대통령에게 협상 시한을 2주 연장해주길 간곡히 요청한다”","date":"2026-04-07T21:12:49.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/GBTDMYRRGNRGIMDFHFSDIZDFGE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[혁신 강국 스위스] ① 실패의 경험을 자산으로… 실무형 인재 키우는 스위스","partialText":"지난달 23일(현지 시각) 스위스 취리히 시내에서 차로 30여 분 떨어진 뒤벤도르프의 스위스 이노베이션 파크. 거대한 직사각형 박스 형태의 ‘스페이스 허브’ 건물로 들어서자 길이 5m 내외의 로켓들이 서 있었다. 로켓마다 비욘드 그래비티, 맥슨, 켈러 등 스위스 우주 기업들의 로고가 붙어 있었다. 곳곳에는 로켓 엔진과 우주 탐사용 로봇 모형이 놓여 있었다.","date":"2026-04-07T21:00:00.000Z","url":"https://www.chosun.com/international/international_general/2026/04/08/MJRDMZJWMQZDAMZQGU4WKMZWGM/"}]
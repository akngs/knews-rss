com/international/us/2025/08/11/PIBMAO2TWVAT5LKRBNAU333PIM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“임신·출산도 로봇이 대신”… 중국서 출시 소식에 ‘발칵’","partialText":"세계 최초의 ‘임신 로봇’이 중국에서 개발 중이라는 보도가 나왔다. 이 로봇은 휴머노이드(인간형 로봇) 형태로, 복부에 인공 자궁을 장착해 10개월간 태아를 품고 출산하도록 설계돼 개발되고 있다. 내년 안에 시제품이 나올 전망이며, 판매가는 10만위안(약 1930만원)가량이 될 것으로 보인다. 중국 과학기술 매체 콰이커지는 지난 8일 임신 로봇을 개발 중인","date":"2025-08-11T07:03:27.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/OYGKENRWCQLD33QNXHYX7LCOEM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"‘팔레스타인 펠레’ 이스라엘군에 사망… UEFA, 사망 경위 언급 피했다","partialText":"","date":"2025-08-10T12:26:26.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/MHJ7CVDY25E4JDF4FJPJD5LMQA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“中 유력 외교장관 후보 류젠차오, 구금 조사 받는 중”","partialText":"","date":"2025-08-10T11:45:44.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/UDR2M3HQ6ZGLDDJXEXBPCAJCYI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"먼지 쌓인 이 책이 얼마라고? 호빗 초판본 8000만원에 경매","partialText":"","date":"2025-08-11T06:48:10.000Z","url":"https://www.chosun.com/international/international_general/2025/08/12/INRMOMKD2BH5HDM6V4EC2YEYUA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"中 베이다이허에 전문가들 모여 AI 회의… 최연소는 33세","partialText":"","date":"2025-08-10T11:14:29.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/SW47CJG6XFDNDC4GSSFUJTG2FA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"푸틴, 우크라전서 숨진 美 CIA 부국장 아들에 훈장... 부모 두 번 울려","partialText":"","date":"2025-08-10T08:34:49.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/WAEKH66QAZEZRJCLVEMH3YGDEE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"대만도 美 관세율 해석 논란… “20%가 아니라 기존 관세에 20% 추가”","partialText":"대만에서 미국이 부과한 상호관세율 해석을 놓고 논란이 일고 있다. 11일(현지 시각) 대만 언론에 따르면 도널드 트럼프 미국 대통령이 지난 7일 발효된 대만에 부과한 20%의 상호관세에 대해 대만 행정원 경제무역협상판공실(OTN)은 이 상호관세가 기존의 최혜국대우(MFN) 세율에 20%를 추가한 것이라고 설명했다. OTN은 대만제 공구기계류의 경우 기존 M","date":"2025-08-11T06:44:13.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/Z332PLDWXDU2277BBJVJ7AH5C4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"워런 버핏, 월가에 경고... “트럼프 관세, 누군가 부담해야 하는 세금”","partialText":"‘오마하의 현인’ 버크셔 해서웨이의 워런 버핏 최고경영자(CEO)가 도널드 트럼프 미국 대통령의 관세 정책에 대해 월가에 경고를 보냈다. 9일(현지 시각) 미 투자전문매체 모틀리풀에 따르면 버핏은 지난 2일 버크셔 해서웨이 분기 실적 발표에서 관세가 기업 운영에 미치는 부정적인 영향을 우려하며 “관세는 누군가가 부담해야 하는 세금”이라고 지적했다. 또 버크","date":"2025-08-11T06:40:50.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/4DXDBF7B2MG5EDVIW6JANGW6RA/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"카타르가 준 비행기, 트럼프 내년 2월에 탈 수 있을까","partialText":"도널드 트럼프 대통령이 카타르에서 기증 받은 비행기가 트럼프 대통령의 예상보다 운항 시기가 늦춰질 것이라는 분석이 나온다. 카타르 비행기를 에어포스원(대통령 전용기)으로 사용하기 위해선 일반 여객기보다 훨씬 복잡한 개조와 점검 절차를 거쳐야 하기 때문이다. 10일(현지 시각) 미국 CBS 등 현지 언론에 따르면 트럼프 대통령은 지난달 29일 카타르 전용기","date":"2025-08-11T06:37:34.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/6CWYULEMPH6ZQFUGF2WRAAC25E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“손흥민의 시대 시작됐다”.. MLS도 활약상 집중 조명","partialText":"","date":"2025-08-10T05:00:08.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/HJTHMYREE5HSVAEI4H2YC5B4RE/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“노숙자들 떠나라”…트럼프, 워싱턴 길거리에 FBI 요원 120명 투입","partialText":"도널드 트럼프 미국 대통령이 노숙자와 범죄자를 소탕한다는 명목으로 워싱턴DC에 연방수사국(FBI) 요원을 긴급 투입한 것으로 알려졌다. 이들은 야간 근무조에 배치됐으며 미군이 추가로 수백명의 주 방위군을 배치할 가능성도 제기된다. 10일(현지 시각) 워싱턴포스트(WP)에 따르면 FBI 요원 120명이 최근 워싱턴DC에 투입되기 시작했으며 비밀경호국 직원들도","date":"2025-08-11T06:05:28.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/XYMCXSSP6YA26AIZUWT4WGPUTI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"[Why] “美 경제 재채기하면 우린 독감 걸린다”... 불야성 사라진 ‘죄악의 도시’ 라스베이거스","partialText":"“미국 경제가 재채기를 하면 라스베이거스는 독감에 걸린다.”테드 파파조지 라스베이거스 호텔·카지노 노조(Culinary Workers Union) 위원장, 월스트리트저널 인터뷰 ‘미국 경제 풍향계’로 불리는 라스베이거스 관광 산업이 급격한 침체에 빠졌다. 올 들어 도시를 찾는 관광객이 눈에 띄게 줄면서, 이를 미국 전체 경기 둔화 전조로 해석하는 분석이 나","date":"2025-08-11T06:04:40.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/NYAO75NRFQMMYVGQQLIJ55ZVNU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"“‘의사당 난입’은 폭력적”… 트럼프와 정반대 해석한 트루스소셜 AI","partialText":"도널드 트럼프 미국 대통령의 소셜미디어(SNS) 플랫폼 ‘트루스소셜’이 최근 공개한 인공지능(AI) 서비스가 그의 주장과 상반된 답변을 내놓는 것으로 나타났다. 트럼프 대통령이 주요 국정 과제로 추진하는 정책에 대해서도 비판적인 입장을 보여 논란이 될 가능성이 있다. 10일(현지 시각) 워싱턴포스트(WP)는 “트럼프 대통령과 트루스소셜에 도입된 새로운 AI","date":"2025-08-11T06:00:33.000Z","url":"https://www.chosun.com/international/international_general/2025/08/11/A2E2YYPLMAQFVR3QIWHWBZVG34/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"美국무부 “브라질, 비선출직 판사가 국가 운명 좌지우지… 권력 분립 무너져“","partialText":"","date":"2025-08-09T21:21:00.000Z","url":"https://www.chosun.com/international/us/2025/08/10/JOLCLJ52AZARFHOKXHBGZUIW4M/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"국제","categories":["international"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/international/?outputType=xml"},"title":"대선 때 트럼프 곤경에 빠뜨린 검사들, 줄줄이 ‘보복 수사’ 대상으로","partialText":"","date":"2025-08-09T20:00:00.000Z","url":"https://www.chosun.com/international/internatio
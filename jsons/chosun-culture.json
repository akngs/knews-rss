[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"통일 향한 ‘동방 정책’… 비서가 동독 간첩으로 밝혀져 총리 사임 빌리 브란트","partialText":"빌리 브란트는 사생아로 태어나 자랐다. 아버지는 함부르크 출신 욘 묄러로 훗날 알게 됐으나 만난 적은 없다. 어머니 마르타 프람도 사생아였다. 어머니의 계부인 외할아버지 밑에서 자랐다. 브란트는 1938년 나치에 반대하며 노르웨이로 망명해 기자로 활동했다. 독일 패전 후 귀국해 1948년 빌리 브란트라는 이름으로 다시 독일 국적을 얻었다.","date":"2025-10-07T20:00:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/10/08/U326K64TSRGKVPWYNI44GABKOU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"[김한수의 오마이갓] 신부님과 샌드백","partialText":"","date":"2025-10-07T16:00:00.000Z","url":"https://www.chosun.com/culture-life/relion-academia/2025/10/08/5VL3TI6XTFH3DP44G43RNQBEWY/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"‘폭군’도 한입 먹고 눈물 흘렸다... 고추장 버터 비빔밥 해외서 인기","partialText":"","date":"2025-10-07T06:32:21.000Z","url":"https://www.chosun.com/culture-life/k-culture/2025/10/07/RP5H3RSCO5FM5MWHANK3ZLB7YM/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"대낮에 잠옷 입고 다니는 듯... 로제도 제니도 과감한 란제리 룩","partialText":"","date":"2025-10-07T11:51:51.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/10/07/EGWQ4L2SRRA5ZGWM6PQTKMRRZQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":
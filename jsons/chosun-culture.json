[{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"[모던 경성]복면가수 ‘미스 코리아’의 이중생활(?)","partialText":"‘마의태자’는 1930년대 대표적 작사가 유도순과 작곡가 김준영이 만든 신민요였다. 노래도 노래지만, ‘미스 코리아’란 예명으로 소개한 가수의 실체가 묘연했다. 음반 가사지에 실린 얼굴 사진에 눈 주위를 가린 ‘복면 가수’로 등장했기 때문이다. 대중의 호기심을 자극한  ‘신비주의 마케팅’이었다.","date":"2025-07-11T21:00:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/07/12/QMBS44U22RCQBAQ5TSGI3CLZJI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"‘부통령과 권총 결투로 피살’ 알렉산더 해밀턴<br>[신문에서 찾았다 오늘 별이 된 사람]","partialText":"해밀턴은 미국 ‘건국의 아버지들’ 중에서 가장 극적인 삶을 살았다. 카리브해 영국령의 작은 섬 네비스에서 사생아로 태어나 9세때부터 고아로 자랐다. 신산스러운 나날에도 남다른 의지와 능력을 보이며 15세때 미국으로 건너갔다. 독립전쟁은 기회였다. 킹스칼리지(현 컬럼비아대)를 중퇴하고 조지 워싱턴 장군 휘하에 들어갔다. 미국 건국 후 초대 재무장관이 된 해밀턴은 버지니아 농장주 출신인 워싱턴 대통령과 제퍼슨 국무장관 같은 건국의 아버지들이 신생국 미국을 농업 중심 나라로 건설하려 할 때 “미국은 사업 천재들의 나라가 될 것”이라고 설득해 사유재산과 특허 보호, 중앙은행 설립 등 미국 자본주의의 기틀을 마련했다.","date":"2025-07-11T20:00:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/07/12/JB4LYQWLDZGLXJUD6XAPYHCMZ4/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"제인 오스틴 소설 속 여주인공의 생존 전략은","partialText":"","date":"2025-07-11T15:51:00.000Z","url":"https://www.chosun.com/culture-life/book/2025/07/12/BKRGHD7DDFBPPEKRHL43ZMMIPU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outpu
5/WBIEPB6KERD2PLSQNYJYCAVZKQ/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"물 대신 음료수만 마신 베트남 남성...신장 속 ‘수백 개’ 결석","partialText":"","date":"2025-07-14T14:55:51.000Z","url":"https://www.chosun.com/culture-life/health/2025/07/14/RAYMCDOTBFHTJG665EGDDD7EME/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"[일사일언] 오래된 기억을 수집하는 일","partialText":"","date":"2025-07-14T15:41:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/07/15/4VQJZ3RMIVFB7GFTIOW3UKPVVU/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"여행 유튜버 작가 신아로미, 英출판사와 1억원 판권 계약","partialText":"","date":"2025-07-14T15:40:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/07/15/OD5LX336NBDELOOMXJNKCDJB5E/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"도서전서 독자들이 줄 선 이유?… ‘북 마케터’ 사인 받으러","partialText":"","date":"2025-07-14T15:33:00.000Z","url":"https://www.chosun.com/culture-life/culture_general/2025/07/15/TCM5PDTSZBECLBLTXRMMZYRQVI/"},{"spec":{"publisher":{"id":"chosun","name":"조선일보","type":"종합일간지","url":"https://www.chosun.com"},"title":"문화/라이프","categories":["culture"],"url":"https://www.chosun.com/arc/outboundfeeds/rss/category/culture-life/?outputType=xml"},"title":"[TV조선] 사라진 비운의 재벌들","partialText":"","date":